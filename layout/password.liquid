<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ shop.name }} — Em Breve</title>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {{ content_for_header }}

  {{ 'base.css' | asset_url | stylesheet_tag }}

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #111111;
      color: #ffffff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .password-page {
      text-align: center;
      max-width: 480px;
      width: 100%;
    }

    .password-page__logo {
      margin-bottom: 2.5rem;
    }

    .password-page__logo svg {
      width: 80px;
      height: auto;
      fill: #ffffff;
    }

    .password-page__label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #FF0000;
      margin-bottom: 1rem;
    }

    .password-page__title {
      font-size: 2.5rem;
      font-weight: 900;
      text-transform: uppercase;
      line-height: 1.1;
      margin-bottom: 1rem;
    }

    .password-page__subtitle {
      font-size: 1rem;
      color: #999999;
      line-height: 1.6;
      margin-bottom: 2.5rem;
    }

    .password-form {
      display: flex;
      gap: 0.5rem;
    }

    .password-form__input {
      flex: 1;
      height: 48px;
      padding: 0 1rem;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 4px;
      color: #ffffff;
      font-size: 0.875rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .password-form__input::placeholder {
      color: #666666;
    }

    .password-form__input:focus {
      border-color: rgba(255, 255, 255, 0.6);
    }

    .password-form__btn {
      height: 48px;
      padding: 0 1.5rem;
      background-color: #ffffff;
      color: #111111;
      border: none;
      border-radius: 4px;
      font-weight: 700;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: background-color 0.2s;
      white-space: nowrap;
    }

    .password-form__btn:hover {
      background-color: #e0e0e0;
    }

    .password-page__error {
      margin-top: 0.75rem;
      font-size: 0.8rem;
      color: #FF0000;
    }

    .password-page__footer {
      margin-top: 3rem;
      font-size: 0.75rem;
      color: #555555;
    }

    .password-page__footer a {
      color: #888888;
      text-decoration: underline;
    }
  </style>
</head>

<body>
  {{ content_for_layout }}
  <div class="password-page">
    <!-- Logo -->
    <div class="password-page__logo">
      <svg viewBox="0 0 69 32" xmlns="http://www.w3.org/2000/svg">
        <path d="M68.56 4.05C67.51 7.09 55.67 30.31 55.67 30.31C55.67 30.31 54.84 32 53.15 32C52.19 32 51.15 31.49 50.57 30.91C48.22 28.56 40.41 22.31 34.02 17.62L22.51 27.61C22.51 27.61 21.37 28.64 20.03 28.64C18.69 28.64 17.42 27.6 17.42 27.6L8.48 20.36C8.48 20.36 0 14.06 0 12.57C0 11.75 0.83 10.67 2.15 10.67C3.23 10.67 4.31 11.26 4.31 11.26L15.86 19.61L61.31 0.09C61.31 0.09 62.8 -0.52 63.86 0.38C65.26 1.59 69.61 1.01 68.56 4.05Z"/>
      </svg>
    </div>

    <p class="password-page__label">{{ 'general.password_page.title' | t }}</p>
    <h1 class="password-page__title">{{ shop.name }}</h1>
    <p class="password-page__subtitle">{{ 'general.password_page.subtitle' | t }}</p>

    <!-- Password Form -->
    {%- form 'storefront_password' -%}
      <div class="password-form">
        <input
          type="password"
          name="password"
          class="password-form__input"
          placeholder="Senha de acesso"
          autocomplete="current-password"
          aria-label="Senha"
          required
        >
        <button type="submit" class="password-form__btn">Entrar</button>
      </div>

      {%- if form.errors -%}
        <p class="password-page__error">Senha incorreta. Tente novamente.</p>
      {%- endif -%}
    {%- endform -%}

    <p class="password-page__footer">
      Powered by <a href="https://www.shopify.com" rel="noopener noreferrer" target="_blank">Shopify</a>
    </p>
  </div>
</body>
</html>
