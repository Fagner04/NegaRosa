{%- comment -%}
  Section: Main Product Details
  A premium, interactive Nike-style product detail page.
{%- endcomment -%}

<style>
  .product-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .product-back {
    margin-bottom: var(--space-6);
  }
  .product-back__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-border, rgba(0,0,0,0.15));
    border-radius: var(--border-radius-full, 999px);
    color: var(--color-text, #111);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .product-back__btn:hover {
    background: var(--color-text, #111);
    color: var(--color-background, #fff);
    border-color: var(--color-text, #111);
  }
  .product-back__btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }
  .product-back__btn:hover svg {
    transform: translateX(-3px);
  }
  @media (max-width: 749px) {
    .product-back {
      margin-bottom: var(--space-4);
    }
    .product-back__btn {
      padding: var(--space-2) var(--space-3);
      font-size: 13px;
    }
  }

  .product-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-12);
    align-items: start;
  }

  /* Gallery */
  .product-gallery {
    display: grid;
    grid-template-columns: 80px 1fr;
    grid-template-rows: auto auto;
    grid-template-areas:
      "thumbs main"
      "desc desc";
    gap: var(--space-3);
    align-items: start;
    direction: ltr;
  }

  /* Thumbnails — coluna vertical à esquerda, abrange todas as linhas */
  .product-gallery__thumbs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-height: 560px;
    overflow-y: auto;
    scrollbar-width: none;
    grid-area: thumbs;
  }

  .product-gallery__thumbs::-webkit-scrollbar { display: none; }

  .product-gallery__thumb {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border-radius: var(--border-radius-md);
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .product-gallery__thumb.active,
  .product-gallery__thumb:hover {
    border-color: var(--color-primary);
  }

  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Foto principal */
  .product-gallery__main {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border-radius: var(--border-radius-lg);
    grid-area: main;
    width: 100%;
  }

  /* Descrição sempre abaixo da foto, ocupando largura total da galeria */
  .product-gallery > .product-description-full {
    grid-area: desc;
  }

  /* Quando o produto tem apenas 1 imagem (sem thumbnails), a foto ocupa toda a largura */
  .product-gallery--single {
    grid-template-columns: 1fr;
    grid-template-areas:
      "main"
      "desc";
  }
  .product-gallery--single .product-gallery__main {
    grid-area: main;
  }

  .product-gallery__main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-gallery__main:hover img {
    transform: scale(1.04);
  }

  /* Mobile carousel — hidden on desktop */
  .product-gallery__mobile-carousel,
  .product-gallery__mobile-dots { display: none; }

  @media (max-width: 767px) {
    .product-gallery {
      grid-template-columns: 1fr;
      grid-template-areas:
        "main"
        "desc";
    }
    .product-gallery__thumbs { display: none; }
    .product-gallery__main {
      order: 1;
      aspect-ratio: auto;
      grid-area: main;
      position: relative;
      overflow: visible;
      background: transparent;
      padding: 0;
    }
    /* Hide the single static image on mobile — carousel takes over */
    .product-gallery__main > #ProductMainImage { display: none; }

    .product-gallery__mobile-carousel {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0;
      touch-action: pan-x;
      border-radius: var(--border-radius-lg, 12px);
      background: var(--color-bg-secondary);
    }
    .product-gallery__mobile-carousel::-webkit-scrollbar { display: none; }
    .product-gallery__mobile-slide {
      flex: 0 0 100%;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      aspect-ratio: 1;
    }
    .product-gallery__mobile-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }
    .product-gallery__mobile-dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-top: 10px;
    }
    .product-gallery__mobile-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      border: none;
      padding: 0;
      background: rgba(0,0,0,.25);
      cursor: pointer;
      transition: background .2s, transform .2s;
    }
    .product-gallery__mobile-dot.active {
      background: var(--color-primary, #000);
      transform: scale(1.25);
    }
  }


  /* Info / Right Column */
  .product-info {
    position: sticky;
    top: calc(var(--header-height) + var(--space-8));
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .product-info__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .product-info__type {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  .product-info__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-tight);
    text-transform: uppercase;
  }

  .product-info__price-wrapper {
    margin-top: var(--space-2);
  }

  .product-info__price-wrapper .price {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
  }

  .product-info__price-wrapper .price--compare {
    font-size: var(--font-size-md);
    color: var(--color-text-light);
    text-decoration: line-through;
    margin-left: var(--space-2);
  }

  .product-info__price-wrapper .price--discount {
    font-size: var(--font-size-sm);
    background-color: var(--color-accent);
    color: var(--color-text-inverse);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-bold);
    margin-left: var(--space-2);
  }

  .product-info__installments {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    margin-top: var(--space-1);
  }

  .product-info__pix {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }
  .product-info__pix svg { flex-shrink: 0; }

  /* Form and Options */
  .product-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-6) 0;
  }

  .option-selector {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .option-selector__label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    display: flex;
    justify-content: flex-start;
    gap: var(--space-1);
  }

  .option-selector__selected {
    font-weight: var(--font-weight-regular);
    color: var(--color-text-light);
    text-transform: none;
  }

  /* Size Selector (Nike Style Grid) */
  .size-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-2);
  }

  .size-button {
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    transition: all var(--transition-fast);
    background: var(--color-bg);
  }

  .size-button:hover:not(.disabled) {
    border-color: var(--color-primary);
  }

  .size-button.active {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  /* Esgotado mas selecionado — borda destaque, fundo acinzentado, texto visível */
  .size-button.active.unavailable,
  .size-button.active.disabled {
    border-color: var(--color-primary);
    background-color: var(--color-bg-secondary);
    color: var(--color-text);
    opacity: 0.7;
  }

  .size-button.disabled {
    opacity: 0.5;
    background-color: var(--color-bg-secondary);
    cursor: pointer;
    position: relative;
  }

  .size-button.disabled::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-border-dark);
    transform: rotate(-25deg);
  }

  /* Color Swatches */
  .color-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .color-swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    cursor: pointer;
    position: relative;
    transition: all var(--transition-fast);
    background-size: cover;
  }

  .color-swatch:hover {
    transform: scale(1.1);
  }

  .color-swatch.active {
    border-color: var(--color-primary);
    transform: scale(1.1);
  }

  .color-swatch.unavailable,
  .color-swatch[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
    position: relative;
  }
  .color-swatch.unavailable::after,
  .color-swatch[disabled]::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--color-border-dark);
    border-radius: 50%;
    background: linear-gradient(
      to bottom right,
      transparent calc(50% - 1px),
      var(--color-border-dark) calc(50% - 1px),
      var(--color-border-dark) calc(50% + 1px),
      transparent calc(50% + 1px)
    );
  }

  .variant-image-swatch.unavailable,
  .variant-image-swatch[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
    position: relative;
  }
  .variant-image-swatch.unavailable::after,
  .variant-image-swatch[disabled]::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--color-border-dark);
    border-radius: var(--border-radius-md);
    background: linear-gradient(
      to bottom right,
      transparent calc(50% - 1px),
      var(--color-border-dark) calc(50% - 1px),
      var(--color-border-dark) calc(50% + 1px),
      transparent calc(50% + 1px)
    );
  }

  .size-button.unavailable {
    opacity: 0.35;
    background-color: var(--color-bg-secondary);
    cursor: pointer;
    position: relative;
  }
  .size-button.unavailable::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--color-border-dark);
    border-radius: var(--border-radius-sm);
    background: linear-gradient(
      to bottom right,
      transparent calc(50% - 1.5px),
      var(--color-border-dark) calc(50% - 1.5px),
      var(--color-border-dark) calc(50% + 1.5px),
      transparent calc(50% + 1.5px)
    );
  }

  /* Em modo block, cores esgotadas mostram cursor not-allowed */
  .option-selector[data-option-name^="cor"] .size-button.unavailable,
  .option-selector[data-option-name^="color"] .size-button.unavailable {
    cursor: not-allowed;
  }

  /* Variant Image Swatches */
  .variant-image-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .variant-image-swatch {
    width: 44px;
    height: 44px;
    border-radius: var(--border-radius-md);
    border: 2px solid var(--color-border);
    overflow: hidden;
    cursor: pointer;
    transition: all var(--transition-fast);
    background-color: var(--color-bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .variant-image-swatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .variant-image-swatch__label {
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    text-align: center;
    line-height: 1.2;
    padding: 2px;
    color: var(--color-text);
  }

  .variant-image-swatch:hover {
    border-color: var(--color-primary);
    transform: scale(1.05);
  }

  .variant-image-swatch.active {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
  }

  /* Quantity and Buttons */
  .qty-selector {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .qty-input-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-full);
    overflow: hidden;
    height: 48px;
  }

  .qty-btn {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-lg);
    background-color: var(--color-bg);
    transition: background-color var(--transition-fast);
  }

  .qty-btn:hover {
    background-color: var(--color-bg-secondary);
  }

  .qty-input {
    width: 40px;
    text-align: center;
    border: none;
    background: transparent;
    font-weight: var(--font-weight-semibold);
    outline: none;
  }

  .product-form__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .btn-add-to-cart {
    height: 54px;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  /* Accordion details */
  .product-details {
    display: flex;
    flex-direction: column;
  }

  .product-details__item {
    border-bottom: 1px solid var(--color-border);
  }

  .product-details__trigger {
    width: 100%;
    padding: var(--space-4) 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    font-size: var(--font-size-base);
  }

  .product-details__trigger svg {
    transition: transform var(--transition-base);
    width: 20px;
    height: 20px;
  }

  .product-details__item.active .product-details__trigger svg {
    transform: rotate(180deg);
  }

  .product-details__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-base) ease;
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  .product-details__item.active .product-details__content {
    max-height: 300px;
    padding-bottom: var(--space-4);
  }

  @media (max-width: 991px) {
    .product-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .product-info {
      position: static;
    }
  }

  /* Descrição dentro da coluna esquerda (galeria) */
  .product-description-full {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .product-description-full__title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .product-description-full__wrapper {
    position: relative;
    overflow: hidden;
    max-height: 110px;
    transition: max-height 0.4s ease;
  }

  .product-description-full__wrapper.expanded {
    max-height: 2000px;
  }

  .product-description-full__content {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  .product-description-full__content p {
    margin-bottom: var(--space-3);
    color: var(--color-text-light);
  }

  .product-description-full__content strong {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .product-description-full__fade {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background: linear-gradient(to bottom, transparent, var(--color-bg, #fff));
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .product-description-full__wrapper.expanded .product-description-full__fade {
    opacity: 0;
  }

  .product-description-full__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 1.5px solid var(--color-primary);
    border-radius: var(--border-radius-sm);
    background: transparent;
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .product-description-full__toggle:hover {
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
  }

  .product-description-full__toggle svg {
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .product-description-full__toggle.expanded svg {
    transform: rotate(180deg);
  }

  /* Size Guide Modal */
  .size-guide-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    padding: var(--space-2) 0;
    margin: var(--space-3) 0;
    transition: color var(--transition-fast);
  }

  .size-guide-trigger:hover {
    color: var(--color-text);
  }

  .size-guide-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-12) var(--space-4) var(--space-4);
  }

  .size-guide-overlay.open {
    display: flex;
  }

  .size-guide-modal {
    background-color: var(--color-bg);
    border-radius: var(--border-radius-lg);
    width: 100%;
    max-width: 500px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xl);
    opacity: 0;
    transform: translateY(20px) scale(0.96);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .size-guide-overlay.open .size-guide-modal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .size-guide-overlay.closing .size-guide-modal {
    opacity: 0;
    transform: translateY(10px) scale(0.97);
    transition: opacity 0.15s ease,
                transform 0.15s ease;
  }

  .size-guide-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .size-guide-modal__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
  }

  .size-guide-modal__close {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color var(--transition-fast);
  }

  .size-guide-modal__close:hover {
    background-color: var(--color-bg-secondary);
  }

  .size-guide-modal__body {
    padding: var(--space-6);
    overflow-y: auto;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }

  .size-guide-modal__empty {
    text-align: center;
    padding: var(--space-10) 0;
    color: var(--color-text-muted);
  }

  .size-guide-modal__empty-hint {
    font-size: var(--font-size-xs);
    margin-top: var(--space-2);
  }

  .size-guide-modal__loading {
    text-align: center;
    padding: var(--space-6);
    color: var(--color-text-muted);
  }

  /* Tabs */
  .sg-tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .sg-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    background-color: var(--color-bg-secondary);
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .sg-tab:hover {
    background-color: var(--color-bg-tertiary, #f0f0f0);
    color: var(--color-text);
  }

  .sg-tab.active {
    background-color: var(--color-bg-secondary, #f7f7f7);
    color: var(--color-text, #111111);
    box-shadow: inset 0 0 0 1px var(--color-border, rgba(0,0,0,0.12));
  }

  /* Tables */
  .sg-table-wrap {
    display: none;
    animation: fadeIn 0.25s ease;
  }

  .sg-table-wrap.active {
    display: block;
  }

  .sg-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .sg-table th {
    background-color: var(--color-bg-secondary);
    font-weight: var(--font-weight-semibold);
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
    font-size: var(--font-size-xs);
  }

  .sg-table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
  }

  .sg-table tbody tr:nth-child(even) {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .sg-footnote {
    margin-top: var(--space-3);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .size-guide-overlay {
      padding: 0;
      align-items: flex-end;
    }

    .size-guide-modal {
      max-width: 100%;
      max-height: 90vh;
      border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
      opacity: 0;
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.2s ease;
    }

    .size-guide-overlay.open .size-guide-modal {
      transform: translateY(0);
    }

    .size-guide-overlay.closing .size-guide-modal {
      opacity: 0;
      transform: translateY(100%);
      transition: transform 0.2s ease,
                  opacity 0.15s ease;
    }

    .sg-tab {
      padding: var(--space-1) var(--space-3);
      font-size: 11px;
    }
    .sg-table th,
    .sg-table td {
      padding: var(--space-1) var(--space-2);
      font-size: 11px;
    }
  }

  /* =====================================================
     RESPONSIVIDADE MOBILE — Página de Produto (escopo isolado)
     ===================================================== */
  @media (max-width: 767px) {
    .product-section { padding: var(--space-4) 0 var(--space-8); }
    .product-container { gap: var(--space-6); }

    /* Título e preços */
    .product-info { gap: var(--space-4); }
    .product-info__title { font-size: var(--font-size-2xl); }
    .product-info__type { font-size: 11px; }
    .product-info__price-wrapper .price { font-size: var(--font-size-xl); }
    .product-info__price-wrapper .price--compare { font-size: var(--font-size-sm); }
    .product-info__price-wrapper .price--discount { font-size: 11px; padding: 2px 6px; }
    .product-info__installments { font-size: 12px; }
    .product-info__pix { font-size: 12px; flex-wrap: wrap; }

    /* Formulário */
    .product-form { gap: var(--space-4); padding: var(--space-4) 0; }
    .option-selector { gap: var(--space-2); }
    .option-selector__label { font-size: 12px; flex-wrap: wrap; }

    /* Seletores de tamanho e cor */
    .size-grid { grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .size-button { height: 40px; font-size: 13px; }
    .color-swatch { width: 32px; height: 32px; }
    .variant-image-swatch { width: 40px; height: 40px; }

    /* Quantidade e botão principal */
    .qty-selector { flex-wrap: wrap; gap: var(--space-3); }
    .qty-input-wrapper { height: 44px; }
    .qty-btn { width: 44px; height: 44px; }
    .product-form__buttons { gap: var(--space-2); margin-top: 0; }
    .btn-add-to-cart { height: 50px; font-size: 14px; }

    /* Favoritos e compartilhar */
    .product-social { gap: var(--space-3); margin-top: 0; }
    .product-social__wishlist { height: 48px; font-size: 14px; }
    .product-social__share {
      flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
    }
    .product-social__share-label { width: 100%; text-align: center; font-size: 12px; }
    .product-social__share-btn { font-size: 13px; }

    /* Card de cálculo de frete */
    .frete-calc { padding: 1rem; margin-top: 1rem; }
    .frete-calc__input-group { flex-wrap: wrap; }
    .frete-calc__input { height: 44px; font-size: 14px; flex: 1 1 100%; }
    .frete-calc__badge {
      height: 36px;
      flex: 1 1 100%;
      justify-content: center;
      font-size: 11px;
    }
    .frete-calc__item {
      padding: 0.5rem 0.625rem;
      gap: 0.375rem;
    }
    .frete-calc__servico { font-size: 12px; }
    .frete-calc__preco { font-size: 13px; }
    .frete-calc__prazo { font-size: 11px; }

    /* Trust badges — grade 3 colunas compacta em vez de virar 1 coluna a 480px */
    .product-trust__row { grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .product-trust__item { font-size: 10px; gap: 4px; }
    .product-trust__item strong { font-size: 11px; }
    .product-trust__item svg { width: 20px; height: 20px; }
    .product-trust__payments-icons { gap: 4px; }
    .pay-icon { width: 40px; height: 26px; }

    /* Accordion */
    .product-details__trigger { padding: var(--space-3) 0; font-size: 13px; }

    /* Descrição completa */
    .product-description-full { margin-top: var(--space-6); padding-top: var(--space-4); }
    .product-description-full__title { font-size: 13px; }
  }

  @media (max-width: 480px) {
    .product-info__title { font-size: var(--font-size-xl); }
    .size-grid { grid-template-columns: repeat(4, 1fr); }
    .product-trust__row { grid-template-columns: repeat(3, 1fr) !important; }
    .product-trust__item { flex-direction: column !important; text-align: center !important; }
    .pay-icon { width: 36px; height: 24px; }
  }
</style>

<section class="product-section">
  <div class="page-width">
    <div class="product-back">
      <a href="{% if collection %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
         class="product-back__btn"
         onclick="if(document.referrer && history.length > 1){event.preventDefault(); history.back();}"
         aria-label="Voltar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Voltar</span>
      </a>
    </div>
    <div class="product-container">
      
      <!-- Left: Media Gallery -->
      <div class="product-gallery reveal-left{% if product.images.size <= 1 %} product-gallery--single{% endif %}">

        <!-- Thumbnails (coluna vertical à esquerda) -->
        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for image in product.images -%}
              <button class="product-gallery__thumb{% if forloop.first %} active{% endif %}"
                      data-image-url="{{ image | image_url: width: 1000 }}"
                      aria-label="Ver imagem {{ forloop.index }}">
                <img src="{{ image | image_url: width: 200 }}"
                     alt="{{ product.title | escape }} - {{ forloop.index }}"
                     width="76" height="76"
                     loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Foto principal -->
        <div class="product-gallery__main">
          {%- if product.featured_image != blank -%}
            <img id="ProductMainImage"
                 src="{{ product.featured_image | image_url: width: 1000 }}"
                 alt="{{ product.title | escape }}"
                 width="1000" height="1000"
                 loading="eager">
          {%- else -%}
            <div style="background-color:var(--color-bg-secondary);width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
              <svg width="100" height="100" viewBox="0 0 60 60" fill="none">
                <rect width="60" height="60" rx="8" fill="#F5F5F5"/>
                <path d="M20 35L25 30L30 35L40 25" stroke="#CACACB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="24" cy="24" r="3" stroke="#CACACB" stroke-width="2"/>
              </svg>
            </div>
          {%- endif -%}

          {%- if product.images.size > 1 -%}
            <!-- Carrossel mobile (swipe) -->
            <div class="product-gallery__mobile-carousel" id="ProductMobileCarousel" aria-label="Galeria de fotos do produto">
              {%- for image in product.images -%}
                <div class="product-gallery__mobile-slide" data-index="{{ forloop.index0 }}">
                  <img src="{{ image | image_url: width: 1000 }}"
                       alt="{{ product.title | escape }} - {{ forloop.index }}"
                       width="1000" height="1000"
                       loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                </div>
              {%- endfor -%}
            </div>
            <div class="product-gallery__mobile-dots" id="ProductMobileDots">
              {%- for image in product.images -%}
                <button type="button" class="product-gallery__mobile-dot{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Ir para imagem {{ forloop.index }}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>


        <!-- Descrição abaixo da foto principal (coluna esquerda) -->
        {%- if product.description != blank -%}
          <div class="product-description-full">
            <h2 class="product-description-full__title">Descrição</h2>
            <div class="product-description-full__wrapper">
              <div class="product-description-full__content rte" id="ProductDescContent">
                {{ product.description }}
              </div>
              <div class="product-description-full__fade" id="ProductDescFade"></div>
            </div>
            <button type="button" class="product-description-full__toggle" id="ProductDescToggle" aria-expanded="false">
              Ver mais detalhes do produto
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <polyline points="6,9 12,15 18,9"></polyline>
              </svg>
            </button>
          </div>
        {%- endif -%}

      </div>

      <!-- Right: Product Information -->
      <div class="product-info reveal-right">
        
        <div class="product-info__header">
          {%- if product.type != blank -%}
            <span class="product-info__type">{{ product.type }}</span>
          {%- endif -%}
          <h1 class="product-info__title">{{ product.title }}</h1>
          
          <div class="product-info__price-wrapper">
            {%- render 'price', product: product -%}
          </div>

          {%- if section.settings.installments_enabled -%}
            {%- assign n_parcelas = section.settings.installments_max -%}
            {%- assign valor_parcela = product.price | divided_by: n_parcelas | money -%}
            {%- if section.settings.installments_no_interest -%}
              {%- assign juros_txt = 'sem juros' -%}
            {%- else -%}
              {%- assign juros_txt = '' -%}
            {%- endif -%}
            {%- assign inst_txt = section.settings.installments_text | replace: '[parcelas]', n_parcelas | replace: '[valor]', valor_parcela | replace: '[juros]', juros_txt -%}
            <div class="product-info__installments">{{ inst_txt }}</div>
          {%- endif -%}

          {%- if section.settings.pix_discount_enabled and section.settings.pix_discount_percent > 0 -%}
            {%- assign pix_pct = section.settings.pix_discount_percent -%}
            {%- assign pix_multiplier = 100 | minus: pix_pct -%}
            {%- assign pix_price_cents = product.price | times: pix_multiplier | divided_by: 100 -%}
            {%- assign pix_price = pix_price_cents | money -%}
            {%- assign pix_txt = section.settings.pix_discount_text | replace: '[valor]', pix_price | replace: '[desconto]', pix_pct -%}
            <div class="product-info__pix" style="color: {{ section.settings.pix_discount_color }};">
              <svg width="18" height="18" viewBox="0 0 512 512" aria-hidden="true" style="flex-shrink:0;display:block;"><path fill="#32BCAD" d="M242.4 292.5C247.8 287.1 257 287.1 262.5 292.5L339.5 369.5C353.7 383.7 372.6 391.5 392.6 391.5H407.7L310.6 488.6C280.3 518.1 231.1 518.1 200.8 488.6L103.3 391.2H112.6C132.7 391.2 151.5 383.4 165.7 369.2L242.4 292.5zM262.5 218.9C256.1 224.4 247.9 224.5 242.4 218.9L165.7 142.2C151.5 127.1 132.6 120.2 112.6 120.2H103.3L200.7 22.8C231.1-7.6 280.3-7.6 310.6 22.8L407.8 119.9H392.6C372.6 119.9 353.7 127.7 339.5 141.9L262.5 218.9zM112.6 142.7C126.4 142.7 139.1 148.3 149.8 158.1L226.5 234.8C233.6 241.9 242.9 245.4 252.2 245.4C261.5 245.4 270.8 241.9 277.9 234.8L354.9 157.8C364.7 148.1 378.3 142.5 392.6 142.5H430.3L488.6 200.8C518.9 231.1 518.9 280.3 488.6 310.6L430.3 368.9H392.6C378.3 368.9 364.7 363.3 354.9 353.5L277.9 276.5C264.4 262.1 240.1 262.1 226.6 276.6L149.8 353.3C139.1 363.1 126.4 368.7 112.6 368.7H81.8L22.8 310.6C-7.6 280.3-7.6 231.1 22.8 200.8L81.8 142.7H112.6z"/></svg>
              <span>{{ pix_txt }}</span>
            </div>
          {%- endif -%}

          {%- comment -%} Atacado: exibe quando o produto tem preço de atacado (metafield), com ou sem o modo ativo {%- endcomment -%}
            {%- assign wholesale_raw = product.metafields.custom.wholesale_price | default: product.metafields.custom.preco_atacado -%}
            {%- assign wholesale_price_str = '' -%}
            {%- if wholesale_raw != blank -%}
              {%- if wholesale_raw.amount -%}
                {%- assign wholesale_price_str = wholesale_raw.amount -%}
              {%- elsif wholesale_raw.value.amount -%}
                {%- assign wholesale_price_str = wholesale_raw.value.amount -%}
              {%- elsif wholesale_raw.value -%}
                {%- assign wholesale_price_str = wholesale_raw.value -%}
              {%- else -%}
                {%- assign wholesale_price_str = wholesale_raw -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign wholesale_price_str = wholesale_price_str | append: '' | replace: ' ', '' | replace: 'R$', '' -%}
            {%- if wholesale_price_str contains ',' -%}
              {%- assign wholesale_price_str = wholesale_price_str | replace: '.', '' | replace: ',', '.' -%}
            {%- endif -%}
            {%- assign wholesale_price_number = wholesale_price_str | times: 1.0 -%}
            {%- assign wholesale_price_cents = 0 -%}
            {%- if wholesale_price_number > 0 -%}
              {%- assign wholesale_price_cents = wholesale_price_number | times: 100 | round -%}
            {%- endif -%}
            {%- if wholesale_price_cents > 0 -%}
              {%- assign wholesale_min_qty = product.metafields.custom.wholesale_min_qty.value | default: product.metafields.custom.wholesale_min_qty -%}
              {%- assign wholesale_mv_raw = product.metafields.custom.wholesale_min_value -%}
              {%- assign wholesale_mv_val = wholesale_mv_raw.value | default: wholesale_mv_raw -%}
              {%- assign wholesale_mv_is_money = false -%}
              {%- if wholesale_mv_val.amount -%}
                {%- assign wholesale_mv_is_money = true -%}
              {%- endif -%}
              {%- assign wholesale_mv_cents = 0 -%}
              {%- unless wholesale_mv_is_money -%}
                {%- assign wholesale_mv_str = wholesale_mv_val | append: '' | replace: ' ', '' | replace: 'R$', '' -%}
                {%- if wholesale_mv_str contains ',' -%}
                  {%- assign wholesale_mv_str = wholesale_mv_str | replace: '.', '' | replace: ',', '.' -%}
                {%- endif -%}
                {%- assign wholesale_mv_num = wholesale_mv_str | times: 1.0 -%}
                {%- if wholesale_mv_num > 0 -%}
                  {%- assign wholesale_mv_cents = wholesale_mv_num | times: 100 | round -%}
                {%- endif -%}
              {%- endunless -%}
              <div class="wholesale-info" style="margin:4px 0;font-size:12px;">
                <span style="color:#9A3412;font-weight:600;">Atacado:</span>
                <strong style="color:#C2410C;font-size:14px;">{{ wholesale_price_cents | money }}</strong>
                {%- if wholesale_min_qty != blank -%}
                  <span style="color:#9A3412;">(mín. {{ wholesale_min_qty }} un.)</span>
                {%- endif -%}
                {%- if wholesale_mv_is_money -%}
                  <br><span style="font-size:11px;color:#B45309;">Pedido mínimo: {{ wholesale_mv_val | money }}</span>
                {%- elsif wholesale_mv_cents > 0 -%}
                  <br><span style="font-size:11px;color:#B45309;">Pedido mínimo: {{ wholesale_mv_cents | money }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
        </div>

        <!-- Add to Cart Form -->
        {%- form 'product', product, id: 'AddToCartForm', class: 'product-form' -%}
          <!-- Hidden Variant Input -->
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="ProductVariantId">

          <!-- Option Selectors -->
          {%- if product.variants.size > 1 -%}
            {%- assign selector_type = section.settings.variant_selector_type | default: settings.variant_selector_type | default: 'block' -%}
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign is_color_option = false
                assign option_name_lower = option.name | downcase
                if option_name_lower == 'cor' or option_name_lower == 'color' or option_name_lower == 'colour' or option_name_lower == 'cores'
                  assign is_color_option = true
                endif

                comment
                  Determina qual tipo de seletor usar para ESTA opção:
                  - Dropdown  → aplica em todas as opções
                  - Swatch    → aplica apenas em opções de cor; demais usam bloco
                  - Img       → aplica apenas em opções de cor; demais usam bloco
                  - Bloco     → aplica em todas as opções
                endcomment

                assign resolved_type = 'block'
                if selector_type == 'dropdown'
                  assign resolved_type = 'dropdown'
                elsif selector_type == 'swatch'
                  if is_color_option
                    assign resolved_type = 'swatch'
                  else
                    assign resolved_type = 'block'
                  endif
                elsif selector_type == 'variant_image'
                  if is_color_option
                    assign resolved_type = 'variant_image'
                  else
                    assign resolved_type = 'block'
                  endif
                endif
              -%}
              <div class="option-selector" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | downcase }}">
                <label class="option-selector__label">
                  {{ option.name }}:
                  <span class="option-selector__selected" id="SelectedOptionVal-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                </label>

                {%- if resolved_type == 'dropdown' -%}
                  {%- comment -%} Suspenso — dropdown para qualquer opção {%- endcomment -%}
                  <select class="input" style="height: 48px;" data-option-select>
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>
                        {{ value }}
                      </option>
                    {%- endfor -%}
                  </select>

                {%- elsif resolved_type == 'swatch' -%}
                  {%- comment -%} Cor da amostra — apenas para opção de Cor {%- endcomment -%}
                  <div class="color-swatches">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign swatch_color = '#cccccc'
                        assign value_lower = value | downcase

                        comment
                          Try meta field custom.swatch_colors first.
                          Suporta: Lista (array) ou Texto de linha única (string).
                          Nomes:  Foggy:#e8ebea
                        endcomment
                        assign swatch_meta_raw = product.metafields.custom.swatch_colors
                        assign swatch_meta_val = swatch_meta_raw.value | default: ''
                        if swatch_meta_val != ''
                          assign cm_size = swatch_meta_val | size
                          assign cm_first_size = swatch_meta_val | first | size
                          if cm_first_size > cm_size
                            assign cm_str = swatch_meta_val | join: '|'
                          else
                            assign cm_str = swatch_meta_val
                          endif
                          assign entries = cm_str | split: '|'
                          for entry in entries
                            assign parts = entry | split: '#'
                            if parts.size == 2
                              assign meta_name = parts[0] | strip | remove: ':' | downcase
                              if meta_name == value_lower
                                assign swatch_color = parts[1] | strip | prepend: '#'
                              endif
                            endif
                          endfor
                        endif

                        comment
                          Fallback to hardcoded mapping if meta didn't match
                        endcomment
                        if swatch_color == '#cccccc'
                          if value_lower contains 'preto' or value_lower contains 'preta' or value_lower contains 'black'
                            assign swatch_color = '#000000'
                          elsif value_lower contains 'branco' or value_lower contains 'branca' or value_lower contains 'white'
                            assign swatch_color = '#ffffff'
                          elsif value_lower contains 'vermelho' or value_lower contains 'vermelha' or value_lower contains 'red'
                            assign swatch_color = '#e60000'
                          elsif value_lower contains 'marinho' or value_lower contains 'navy'
                            assign swatch_color = '#001f5b'
                          elsif value_lower contains 'azul' or value_lower contains 'blue'
                            assign swatch_color = '#0044ff'
                          elsif value_lower contains 'verde' or value_lower contains 'green'
                            assign swatch_color = '#00aa33'
                          elsif value_lower contains 'cinza' or value_lower contains 'grey' or value_lower contains 'gray'
                            assign swatch_color = '#888888'
                          elsif value_lower contains 'rosa' or value_lower contains 'pink'
                            assign swatch_color = '#ff69b4'
                          elsif value_lower contains 'amarelo' or value_lower contains 'yellow'
                            assign swatch_color = '#f5c518'
                          elsif value_lower contains 'laranja' or value_lower contains 'orange'
                            assign swatch_color = '#ff6600'
                          elsif value_lower contains 'roxo' or value_lower contains 'purple' or value_lower contains 'violeta'
                            assign swatch_color = '#7b2fbe'
                          elsif value_lower contains 'bege' or value_lower contains 'beige' or value_lower contains 'nude'
                            assign swatch_color = '#c8a882'
                          elsif value_lower contains 'caramelo' or value_lower contains 'camel' or value_lower contains 'marrom' or value_lower contains 'brown'
                            assign swatch_color = '#8b4513'
                          endif
                        endif
                      -%}
                      <button type="button"
                              class="color-swatch{% if option.selected_value == value %} active{% endif %}"
                              data-value="{{ value | escape }}"
                              style="background-color: {{ swatch_color }};"
                              title="{{ value | escape }}"
                              aria-label="{{ value | escape }}">
                      </button>
                    {%- endfor -%}
                  </div>

                {%- elsif resolved_type == 'variant_image' -%}
                  {%- comment -%} Imagem da variante — apenas para opção de Cor {%- endcomment -%}
                  <div class="variant-image-swatches">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign variant_img = nil
                        for variant in product.variants
                          if variant.options contains value
                            if variant.image != blank
                              assign variant_img = variant.image
                              break
                            endif
                          endif
                        endfor
                      -%}
                      <button type="button"
                              class="variant-image-swatch{% if option.selected_value == value %} active{% endif %}"
                              data-value="{{ value | escape }}"
                              title="{{ value | escape }}"
                              aria-label="{{ value | escape }}">
                        {%- if variant_img != blank -%}
                          <img src="{{ variant_img | image_url: width: 100 }}"
                               alt="{{ value | escape }}"
                               width="50" height="50"
                               loading="lazy">
                        {%- else -%}
                          <span class="variant-image-swatch__label">{{ value | truncate: 6, '' }}</span>
                        {%- endif -%}
                      </button>
                    {%- endfor -%}
                  </div>

                {%- else -%}
                  {%- comment -%} Bloco — grade de botões (padrão para tamanho e demais) {%- endcomment -%}
                  <div class="size-grid">
                    {%- for value in option.values -%}
                      <button type="button"
