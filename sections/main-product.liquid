          {%- assign payment_page = pages[section.settings.payment_page] -%}
          {%- if section.settings.pages_display_mode == 'all' or section.settings.pages_display_mode == 'text_only' or payment_page != blank -%}
            <div class="product-details__item">
              <button class="product-details__trigger">
                Métodos de Pagamento
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div class="product-details__content">
                {%- if payment_page != blank -%}
                  <div class="rte">{{ payment_page.content }}</div>
                {%- else -%}
                  <p>{{ section.settings.payment_text }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- comment -%} Accordion 3: Página extra opcional {%- endcomment -%}
          {%- assign extra_page = pages[section.settings.extra_page] -%}
          {%- if extra_page != blank -%}
            <div class="product-details__item">
              <button class="product-details__trigger">
                {{ extra_page.title }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div class="product-details__content">
                <div class="rte">{{ extra_page.content }}</div>
              </div>
            </div>
          {%- endif -%}

        </div>

      </div>

    </div>

    <!-- Seção Talvez Você Goste logo abaixo do grid -->

  </div>
</section>

<!-- Seção: Talvez Você Goste -->
{%- assign related_collection = product.collections.first -%}
{%- if related_collection != blank -%}
  {%- assign related_products = related_collection.products | where: 'id', '!=', product.id -%}
  {%- if related_collection.products.size > 1 -%}
    <section class="related-products-section">
      <div class="page-width">

        <div class="related-products__header">
          <h2 class="related-products__title">Talvez Você Goste</h2>
          <a href="{{ related_collection.url }}" class="related-products__link hover-underline">
            Ver tudo
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </a>
        </div>

        <div class="related-products__carousel" id="RelatedCarousel">
          {%- assign shown = 0 -%}
          {%- for p in related_collection.products limit: 9 -%}
            {%- if p.id != product.id and shown < 8 -%}
              <div class="related-products__item">
                {%- render 'product-card',
                  product: p,
                  show_secondary_image: true,
                  show_quick_add: true,
                  show_wishlist: true,
                  show_badge: true,
                  show_category: true
                -%}
              </div>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Setas de navegação -->
        <div class="related-products__nav">
          <button class="related-products__nav-btn" id="RelatedPrev" aria-label="Anterior">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20">
              <polyline points="15,18 9,12 15,6"></polyline>
            </svg>
          </button>
          <button class="related-products__nav-btn" id="RelatedNext" aria-label="Próximo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </button>
        </div>

      </div>
    </section>

    <style>
      .related-products-section {
        padding: var(--space-16) 0;
        border-top: 1px solid var(--color-border);
        background-color: var(--color-bg-secondary);
      }

      .related-products__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-8);
      }

      .related-products__title {
        font-size: var(--font-size-2xl);
        font-weight: var(--font-weight-extrabold);
        text-transform: uppercase;
        letter-spacing: -0.01em;
      }

      .related-products__link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        color: var(--color-text);
        text-decoration: none;
      }

      .related-products__carousel {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: calc(25% - var(--space-4));
        gap: var(--space-5);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
        scroll-behavior: smooth;
        touch-action: pan-x;
        padding-bottom: var(--space-2);
      }

      .related-products__carousel::-webkit-scrollbar {
        display: none;
      }

      .related-products__item {
        scroll-snap-align: start;
        min-width: 0;
      }

      .related-products__nav {
        display: flex;
        justify-content: flex-end;
        gap: var(--space-2);
        margin-top: var(--space-6);
      }

      .related-products__nav-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--color-border);
        background: var(--color-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all var(--transition-fast);
      }

      .related-products__nav-btn:hover {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: #fff;
      }

      @media (max-width: 991px) {
        .related-products__carousel {
          grid-auto-columns: calc(50% - var(--space-3));
        }
      }

      @media (max-width: 540px) {
        .related-products__carousel {
          grid-auto-columns: calc(70% - var(--space-3));
        }
        .related-products__title {
          font-size: var(--font-size-xl);
        }
      }
    </style>

    <script>
      (function () {
        var carousel = document.getElementById('RelatedCarousel');
        var btnPrev  = document.getElementById('RelatedPrev');
        var btnNext  = document.getElementById('RelatedNext');
        if (!carousel || !btnPrev || !btnNext) return;

        function getScrollAmount() {
          var item = carousel.querySelector('.related-products__item');
          return item ? item.offsetWidth + 20 : 280;
        }

        btnNext.addEventListener('click', function () {
          carousel.scrollLeft += getScrollAmount();
        });

        btnPrev.addEventListener('click', function () {
          carousel.scrollLeft -= getScrollAmount();
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

<!-- Frontend Logic for Variant Selection, Thumbnails & Accordion -->
<script>
  (function() {
    function initProductPage() {
    
    // Descrição expandir/colapsar
    var descWrapper = document.getElementById('ProductDescContent');
    descWrapper = descWrapper ? descWrapper.closest('.product-description-full__wrapper') : null;
    var descBtn = document.getElementById('ProductDescToggle');
    if (descWrapper && descBtn) {
      descBtn.addEventListener('click', function () {
        var isExpanded = descWrapper.classList.contains('expanded');
        descWrapper.classList.toggle('expanded');
        descBtn.classList.toggle('expanded');
        descBtn.setAttribute('aria-expanded', String(!isExpanded));
        descBtn.childNodes[0].textContent = isExpanded
          ? 'Ver mais detalhes do produto'
          : 'Ver menos ';
      });
    }

    // Mobile: mover descrição para o final, abaixo das formas de pagamento (trust badges)
    (function relocateDescriptionMobile(){
      var descEl = document.querySelector('.product-gallery > .product-description-full');
      var anchorEl = document.querySelector('.frete-calc') || document.querySelector('.product-trust');
      var galleryEl = document.querySelector('.product-gallery');
      if (!descEl || !anchorEl || !galleryEl) return;
      var placeholder = document.createComment('desc-original-slot');
      var originalParent = descEl.parentNode;
      var originalNext = descEl.nextSibling;
      originalParent.insertBefore(placeholder, descEl);
      var mq = window.matchMedia('(max-width: 767px)');
      function apply(e){
        if (e.matches) {
          if (descEl.previousSibling !== anchorEl) {
            anchorEl.parentNode.insertBefore(descEl, anchorEl.nextSibling);
          }

        } else {
          if (placeholder.parentNode) {
            placeholder.parentNode.insertBefore(descEl, placeholder);
          }
        }
      }
      apply(mq);
      (mq.addEventListener ? mq.addEventListener('change', apply) : mq.addListener(apply));
    })();



    // Product Gallery Image Swap
    var mainImg = document.getElementById('ProductMainImage');
    var thumbs = document.querySelectorAll('.product-gallery__thumb');
    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        thumbs.forEach(function(t) { t.classList.remove('active'); });
        thumb.classList.add('active');
        var newUrl = thumb.getAttribute('data-image-url');
        if (mainImg && newUrl) {
          mainImg.setAttribute('src', newUrl);
        }
      });
    });

    // Accordions
    var accordionItems = document.querySelectorAll('.product-details__item');
    accordionItems.forEach(function(item) {
      var trigger = item.querySelector('.product-details__trigger');
      if (trigger) {
        trigger.addEventListener('click', function() {
          var isActive = item.classList.contains('active');
          accordionItems.forEach(function(i) { i.classList.remove('active'); });
          if (!isActive) {
            item.classList.add('active');
          }
        });
      }
    });

    // Quantity selector buttons
    var qtyInput = document.getElementById('ProductQuantity');
    var qtyMinus = document.getElementById('QtyMinus');
    var qtyPlus  = document.getElementById('QtyPlus');

    // Shopify Variant Options Helper
    var variants = [
      {%- for variant in product.variants -%}
        {
          id: {{ variant.id }},
          title: "{{ variant.title | escape }}",
          options: {{ variant.options | json }},
          available: {{ variant.available }},
          inventory_quantity: {{ variant.inventory_quantity | default: 0 }},
          inventory_policy: "{{ variant.inventory_policy }}",
          price: "{{ variant.price | money }}",
          price_cents: {{ variant.price }},
          compare_at_price: {% if variant.compare_at_price %}"{{ variant.compare_at_price | money }}"{% else %}null{% endif %},
          compare_at_price_cents: {% if variant.compare_at_price %}{{ variant.compare_at_price }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ];

    // Product Gallery — Mobile Carousel (dots ↔ swipe)
    (function initMobileGalleryCarousel(){
      var carousel = document.getElementById('ProductMobileCarousel');
      var dotsWrap = document.getElementById('ProductMobileDots');
      if (!carousel || !dotsWrap) return;
      var slides = carousel.querySelectorAll('.product-gallery__mobile-slide');
      var dots = dotsWrap.querySelectorAll('.product-gallery__mobile-dot');
      if (!slides.length) return;

      function setActive(idx){
        dots.forEach(function(d, i){ d.classList.toggle('active', i === idx); });
      }

      // Scroll → active dot
      var scrollTO;
      carousel.addEventListener('scroll', function(){
        clearTimeout(scrollTO);
        scrollTO = setTimeout(function(){
          var w = carousel.clientWidth;
          if (w > 0) setActive(Math.round(carousel.scrollLeft / w));
        }, 60);
      }, { passive: true });

      // Dot click → scroll
      dots.forEach(function(dot, i){
        dot.addEventListener('click', function(){
          carousel.scrollTo({ left: i * carousel.clientWidth, behavior: 'smooth' });
          setActive(i);
        });
      });
    })();

    // Retorna o estoque máximo da variante atualmente selecionada
    function getMaxStock() {
      var variantIdInput = document.getElementById('ProductVariantId');
      if (!variantIdInput) return 999;
      var currentId = parseInt(variantIdInput.value);
      var v = null;
      for (var vi = 0; vi < variants.length; vi++) {
        if (variants[vi].id === currentId) { v = variants[vi]; break; }
      }
      if (!v) return 999;
      if (v.inventory_policy === 'continue') return 999;
      return v.inventory_quantity > 0 ? v.inventory_quantity : 0;
    }

    function clampQty() {
      if (!qtyInput) return;
      var max = getMaxStock();
      var val = parseInt(qtyInput.value) || 1;
      if (val < 1) val = 1;
      if (max > 0 && val > max) val = max;
      qtyInput.value = val;
      qtyInput.max = max > 0 ? max : 1;
      if (qtyPlus) qtyPlus.disabled = (max <= 0 || val >= max);
      if (qtyMinus) qtyMinus.disabled = (val <= 1);
    }

    if (qtyInput && qtyMinus && qtyPlus) {
      qtyMinus.addEventListener('click', function() {
        var val = parseInt(qtyInput.value) || 1;
        if (val > 1) { qtyInput.value = val - 1; }
        clampQty();
      });
      qtyPlus.addEventListener('click', function() {
        var val = parseInt(qtyInput.value) || 1;
        var max = getMaxStock();
        if (max <= 0 || val < max) { qtyInput.value = val + 1; }
        clampQty();
      });
      qtyInput.addEventListener('change', clampQty);
      clampQty();
    }

    // Section settings para cálculos no JS
    var sectionSettings = {
      installments_enabled: {{ section.settings.installments_enabled | json }},
      installments_max: {{ section.settings.installments_max }},
      installments_no_interest: {{ section.settings.installments_no_interest | json }},
      installments_text: {{ section.settings.installments_text | json }},
      pix_discount_enabled: {{ section.settings.pix_discount_enabled | json }},
      pix_discount_percent: {{ section.settings.pix_discount_percent }},
      pix_discount_text: {{ section.settings.pix_discount_text | json }}
    };

    function parseCents(str) {
      return parseInt(String(str).replace(/[^\d]/g, '')) || 0;
    }
    function fmtCents(cents) {
      return 'R$ ' + (cents / 100).toFixed(2).replace('.', ',');
    }

    function updateInstallmentsPix(variant) {
      if (!variant) return;
      var priceCents = variant.price_cents || parseCents(variant.price);
      // Installments
      if (sectionSettings.installments_enabled) {
        var instEl = document.querySelector('.product-info__installments');
        if (instEl) {
          var instCents = Math.round(priceCents / sectionSettings.installments_max);
          var jurosTxt = sectionSettings.installments_no_interest ? 'sem juros' : '';
          var instVal = fmtCents(instCents);
          var instHtml = sectionSettings.installments_text
            .replace('[parcelas]', sectionSettings.installments_max)
            .replace('[valor]', instVal)
            .replace('[juros]', jurosTxt);
          instEl.textContent = instHtml;
        }
      }
      // PIX
      if (sectionSettings.pix_discount_enabled && sectionSettings.pix_discount_percent > 0) {
        var pixEl = document.querySelector('.product-info__pix');
        if (pixEl) {
          var pixCents = Math.round(priceCents * (100 - sectionSettings.pix_discount_percent) / 100);
          var pixVal = fmtCents(pixCents);
          var pixHtml = sectionSettings.pix_discount_text
            .replace('[valor]', pixVal)
            .replace('[desconto]', sectionSettings.pix_discount_percent);
          var pixSpan = pixEl.querySelector('span');
          if (pixSpan) pixSpan.textContent = pixHtml;
        }
      }
    }

    var form = document.getElementById('AddToCartForm');
    if (!form) {
      console.warn('[ProductPage] Form #AddToCartForm não encontrado.');
      return;
    }

    // AJAX add-to-cart: evita redirecionamento para /cart
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var addBtn = document.getElementById('AddToCartBtn');
      if (!addBtn || addBtn.disabled) return;
      var originalText = addBtn.textContent;
      addBtn.disabled = true;
      addBtn.textContent = 'Adicionando...';

      var formData = new FormData(form);
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
      })
        .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
        .then(function (res) {
          if (!res.ok) {
            addBtn.textContent = (res.data && res.data.description) || 'Erro';
            setTimeout(function () { addBtn.disabled = false; addBtn.textContent = originalText; }, 1800);
            return;
          }
          addBtn.textContent = 'Adicionado ✓';
          // Atualiza contador do carrinho no header
          fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
            document.querySelectorAll('.header__cart-count').forEach(function (el) {
              el.textContent = cart.item_count;
              el.style.display = cart.item_count > 0 ? 'flex' : 'none';
            });
          }).catch(function(){});
          setTimeout(function () { addBtn.disabled = false; addBtn.textContent = originalText; }, 1500);
        })
        .catch(function () {
          addBtn.textContent = 'Erro';
          setTimeout(function () { addBtn.disabled = false; addBtn.textContent = originalText; }, 1800);
        });
    });


    function getSelectedOptions() {
      var selectedOptions = [];
      var optionSelectors = form.querySelectorAll('.option-selector');
      for (var i = 0; i < optionSelectors.length; i++) {
        var selector = optionSelectors[i];
        var activeVal = '';

        // Size buttons
        var sizeBtn = selector.querySelector('.size-button.active');
        if (sizeBtn) activeVal = sizeBtn.getAttribute('data-value');

        // Color swatches
        var colorBtn = selector.querySelector('.color-swatch.active');
        if (colorBtn) activeVal = colorBtn.getAttribute('data-value');

        // Variant image swatches
        var variantImgBtn = selector.querySelector('.variant-image-swatch.active');
        if (variantImgBtn) activeVal = variantImgBtn.getAttribute('data-value');

        // Default select
        var selectEl = selector.querySelector('select');
        if (selectEl) activeVal = selectEl.value;

        selectedOptions.push(activeVal);
      }
      return selectedOptions;
    }

    function markUnavailableOptions() {
      var currentSelected = getSelectedOptions();
      var optionSelectors = form.querySelectorAll('.option-selector');

      for (var idx = 0; idx < optionSelectors.length; idx++) {
        var selector = optionSelectors[idx];
        // Reúne todos os botões clicáveis desta opção
        var allBtns = selector.querySelectorAll('.size-button, .color-swatch, .variant-image-swatch');

        for (var b = 0; b < allBtns.length; b++) {
          var btn = allBtns[b];
          var val = btn.getAttribute('data-value');

          // Verifica se existe alguma variante disponível onde esta opção
          // tenha esse valor E as demais opções combinem com a seleção atual
          var avail = false;
          for (var vi = 0; vi < variants.length; vi++) {
            var v = variants[vi];
            if (v.options[idx] !== val) continue;
            if (!v.available) continue;
            // Verifica as outras opções selecionadas
            var match = true;
            for (var oi = 0; oi < currentSelected.length; oi++) {
              if (oi === idx) continue; // pula a opção que estamos verificando
              if (currentSelected[oi] && v.options[oi] !== currentSelected[oi]) {
                match = false;
                break;
              }
            }
            if (match) { avail = true; break; }
          }

          if (avail) {
            btn.classList.remove('unavailable');
            btn.removeAttribute('disabled');
          } else {
            btn.classList.add('unavailable');
            // Para cores: bloqueia completamente com disabled
            if (btn.classList.contains('color-swatch') || btn.classList.contains('variant-image-swatch')) {
              btn.setAttribute('disabled', 'disabled');
            }
          }
        }

        // Oculta a seção inteira se TODOS os botões estiverem esgotados (só para cores)
        var optionName = selector.getAttribute('data-option-name');
        var isColor = optionName && (optionName.indexOf('cor') === 0 || optionName.indexOf('color') === 0 || optionName.indexOf('colour') === 0);
        if (isColor) {
          var allUnavailable = true;
          for (var b2 = 0; b2 < allBtns.length; b2++) {
            if (!allBtns[b2].classList.contains('unavailable')) {
              allUnavailable = false;
              break;
            }
          }
          if (allBtns.length > 0) {
            selector.style.display = allUnavailable ? 'none' : '';
          }
        }
      }
    }

    // Handle Option Click (Sizes, Colors, Dropdowns)
    function updateSelectedOptions() {
      var selectedOptions = getSelectedOptions();

      // Update label display text
      for (var i = 0; i < selectedOptions.length; i++) {
        var labelDisplay = document.getElementById('SelectedOptionVal-' + i);
        if (labelDisplay) {
          labelDisplay.textContent = selectedOptions[i];
        }
      }

      // Find matching variant
      var matchedVariant = null;
      for (var vi = 0; vi < variants.length; vi++) {
        var variant = variants[vi];
        var match = true;
        for (var oi = 0; oi < variant.options.length; oi++) {
          if (variant.options[oi] !== selectedOptions[oi]) {
            match = false;
            break;
          }
        }
        if (match) { matchedVariant = variant; break; }
      }

      var variantIdInput = document.getElementById('ProductVariantId');
      var addToCartBtn = document.getElementById('AddToCartBtn');
      var productInfo = form.closest('.product-info');
      var priceWrapper = productInfo ? productInfo.querySelector('.product-info__price-wrapper') : null;

      if (matchedVariant) {
        variantIdInput.value = matchedVariant.id;
        
        // Update Price Display
        if (priceWrapper) {
          if (matchedVariant.compare_at_price) {
            var compareCents = parseCents(matchedVariant.compare_at_price);
            var priceCentsVal = parseCents(matchedVariant.price);
            var discountPct = compareCents > 0 ? Math.round((compareCents - priceCentsVal) / compareCents * 100) : 0;
            priceWrapper.innerHTML = '<span class="price price--sale">' + matchedVariant.price + '</span>' +
              '<span class="price price--compare">' + matchedVariant.compare_at_price + '</span>' +
              '<span class="price price--discount">-' + discountPct + '%</span>';
          } else {
            priceWrapper.innerHTML = '<span class="price">' + matchedVariant.price + '</span>';
          }
        }

        // Update button state
        if (matchedVariant.available) {
          addToCartBtn.disabled = false;
          addToCartBtn.textContent = 'Adicionar à Sacola';
        } else {
          addToCartBtn.disabled = true;
          addToCartBtn.textContent = 'Esgotado';
        }

        // Atualiza parcelamento e PIX com o preço da variante
        updateInstallmentsPix(matchedVariant);

        // Re-valida quantidade conforme estoque da nova variante
        clampQty();

      } else {
        addToCartBtn.disabled = true;
        addToCartBtn.textContent = 'Indisponível';
      }

      // Re-marca opções indisponíveis considerando contexto
      markUnavailableOptions();
    }

    // Set up option event listeners
    var optionSelectors = form.querySelectorAll('.option-selector');
    for (var si = 0; si < optionSelectors.length; si++) {
      (function(selector) {
        // Size buttons
        var sizeBtns = selector.querySelectorAll('.size-button');
        for (var bi = 0; bi < sizeBtns.length; bi++) {
          (function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              // Em modo block, cores esgotadas não devem ser clicáveis
              var optionName = selector.getAttribute('data-option-name');
              var isColor = optionName && (optionName.indexOf('cor') === 0 || optionName.indexOf('color') === 0 || optionName.indexOf('colour') === 0);
              if (isColor && btn.classList.contains('unavailable')) return;
              var allSizeBtns = selector.querySelectorAll('.size-button');
              for (var ri = 0; ri < allSizeBtns.length; ri++) {
                allSizeBtns[ri].classList.remove('active');
              }
              btn.classList.add('active');
              updateSelectedOptions();
            });
          })(sizeBtns[bi]);
        }

        // Color swatches
        var colorBtns = selector.querySelectorAll('.color-swatch');
        for (var ci = 0; ci < colorBtns.length; ci++) {
          (function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              // Cores esgotadas NÃO são clicáveis
              if (btn.classList.contains('unavailable')) return;
              var allColorBtns = selector.querySelectorAll('.color-swatch');
              for (var ri = 0; ri < allColorBtns.length; ri++) {
                allColorBtns[ri].classList.remove('active');
              }
              btn.classList.add('active');
              updateSelectedOptions();
            });
          })(colorBtns[ci]);
        }

        // Variant image swatches
        var imgBtns = selector.querySelectorAll('.variant-image-swatch');
        for (var ii = 0; ii < imgBtns.length; ii++) {
          (function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              if (btn.classList.contains('unavailable')) return;
              var allImgBtns = selector.querySelectorAll('.variant-image-swatch');
              for (var ri = 0; ri < allImgBtns.length; ri++) {
                allImgBtns[ri].classList.remove('active');
              }
              btn.classList.add('active');
              updateSelectedOptions();
            });
          })(imgBtns[ii]);
        }

        // Dropdown selector
        var selectEl = selector.querySelector('select');
        if (selectEl) {
          selectEl.addEventListener('change', function() {
            updateSelectedOptions();
          });
        }
      })(optionSelectors[si]);
    }

    // Estado inicial
    updateSelectedOptions();
    markUnavailableOptions();

    // Size Guide Modal
    function initSizeGuideModal() {
      var trigger = document.querySelector('[data-open-modal]');
      var overlay = document.querySelector('[data-modal-overlay]');
      var close = document.querySelector('[data-close-modal]');
      if (!trigger || !overlay) return;

      function open() {
        overlay.classList.remove('closing');
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!overlay.classList.contains('open')) return;
        overlay.classList.add('closing');
        overlay.addEventListener('transitionend', function handler() {
          overlay.removeEventListener('transitionend', handler);
          overlay.classList.remove('open', 'closing');
          document.body.style.overflow = '';
        });
      }

      trigger.addEventListener('click', open);
      if (close) close.addEventListener('click', closeModal);
      overlay.addEventListener('click', function(e) { if (e.target === overlay) closeModal(); });
      document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });
    }
    initSizeGuideModal();

    } // end initProductPage

    // Garante execução mesmo se DOMContentLoaded já disparou
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductPage);
    } else {
      initProductPage();
    }
  })();

  document.body.setAttribute('data-variant-type', '{{ section.settings.variant_selector_type | default: settings.variant_selector_type | default: 'block' }}');
</script>

