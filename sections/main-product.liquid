        <script>
          (function () {
            // Favoritos
            var wishlistBtn = document.getElementById('WishlistBtn');
            if (wishlistBtn) {
              var productId = wishlistBtn.getAttribute('data-product-id');
              var storageKey = 'wishlist_' + productId;
              var isSaved = localStorage.getItem(storageKey) === '1';
              if (isSaved) wishlistBtn.classList.add('active');

              wishlistBtn.addEventListener('click', function () {
                isSaved = !isSaved;
                wishlistBtn.classList.toggle('active', isSaved);
                localStorage.setItem(storageKey, isSaved ? '1' : '0');
                var txt = wishlistBtn.querySelector('.product-social__wishlist-text');
                if (txt) txt.textContent = isSaved ? 'Salvo nos favoritos' : 'Salvar como favoritos';
              });
            }

            // Copiar link
            var copyBtn  = document.getElementById('CopyLinkBtn');
            var copyText = document.getElementById('CopyLinkText');
            if (copyBtn && copyText) {
              copyBtn.addEventListener('click', function () {
                var url = window.location.href;
                if (navigator.clipboard) {
                  navigator.clipboard.writeText(url).then(function () {
                    copyText.textContent = 'Link copiado!';
                    setTimeout(function () { copyText.textContent = 'Copiar link'; }, 2500);
                  });
                } else {
                  var ta = document.createElement('textarea');
                  ta.value = url;
                  document.body.appendChild(ta);
                  ta.select();
                  document.execCommand('copy');
                  document.body.removeChild(ta);
                  copyText.textContent = 'Link copiado!';
                  setTimeout(function () { copyText.textContent = 'Copiar link'; }, 2500);
                }
              });
            }
          })();
        </script>

