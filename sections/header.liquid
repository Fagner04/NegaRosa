{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo da loja"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largura da logo no desktop (px)",
      "min": 60,
      "max": 260,
      "step": 10,
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
