{%- comment -%}
  Section: Main Account
  Customer account dashboard with order history
{%- endcomment -%}

<section style="padding-top: var(--space-12); padding-bottom: var(--space-16);">
  <div class="page-width">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-10); flex-wrap: wrap; gap: var(--space-4);">
      <div>
        <h1 style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-extrabold); text-transform: uppercase;">
          Olá, {{ customer.first_name }}
        </h1>
        <p style="font-size: var(--font-size-sm); color: var(--color-text-light); margin-top: var(--space-1);">
          {{ customer.email }}
        </p>
      </div>
      <div style="display: flex; gap: var(--space-3);">
        <a href="/account/addresses" class="btn btn-secondary btn-ripple" style="height: 40px; padding: 0 var(--space-5); font-size: var(--font-size-sm);">Meus Endereços</a>
        <a href="/account/logout" class="btn" style="height: 40px; padding: 0 var(--space-5); font-size: var(--font-size-sm); border: 1px solid var(--color-border);">Sair</a>
      </div>
    </div>

    <!-- Order History -->
    <h2 style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); text-transform: uppercase; margin-bottom: var(--space-6);">
      Histórico de Pedidos
    </h2>

    {%- if customer.orders.size > 0 -%}
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: var(--font-size-sm);">
          <thead>
            <tr style="border-bottom: 2px solid var(--color-border); text-align: left;">
              <th style="padding: var(--space-3) var(--space-4) var(--space-3) 0; font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em;">Pedido</th>
              <th style="padding: var(--space-3) var(--space-4); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em;">Data</th>
              <th style="padding: var(--space-3) var(--space-4); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em;">Pagamento</th>
              <th style="padding: var(--space-3) var(--space-4); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em;">Entrega</th>
              <th style="padding: var(--space-3) 0 var(--space-3) var(--space-4); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em; text-align: right;">Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr style="border-bottom: 1px solid var(--color-border);">
                <td style="padding: var(--space-4) var(--space-4) var(--space-4) 0;">
                  <a href="{{ order.customer_url }}" style="font-weight: var(--font-weight-semibold); text-decoration: underline; color: var(--color-text);">
                    {{ order.name }}
                  </a>
                </td>
                <td style="padding: var(--space-4); color: var(--color-text-light);">
                  {{ order.created_at | date: '%d/%m/%Y' }}
                </td>
                <td style="padding: var(--space-4);">
                  <span style="
                    display: inline-block;
                    padding: 2px 10px;
                    border-radius: 20px;
                    font-size: var(--font-size-xs);
                    font-weight: var(--font-weight-semibold);
                    background-color: {%- if order.financial_status == 'paid' -%}#e6f4ea{%- elsif order.financial_status == 'pending' -%}#fff8e1{%- else -%}#fce8e6{%- endif -%};
                    color: {%- if order.financial_status == 'paid' -%}#137333{%- elsif order.financial_status == 'pending' -%}#f9a825{%- else -%}#c5221f{%- endif -%};
                  ">
                    {{ order.financial_status_label }}
                  </span>
                </td>
                <td style="padding: var(--space-4); color: var(--color-text-light);">
                  {{ order.fulfillment_status_label }}
                </td>
                <td style="padding: var(--space-4) 0 var(--space-4) var(--space-4); text-align: right; font-weight: var(--font-weight-semibold);">
                  {{ order.total_price | money }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- else -%}
      <div style="text-align: center; padding: var(--space-16) 0; display: flex; flex-direction: column; align-items: center; gap: var(--space-4);">
        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="var(--color-secondary)" stroke-width="1.5">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        <p style="font-size: var(--font-size-base); color: var(--color-text-light);">Você ainda não fez nenhum pedido.</p>
        <a href="/collections/all" class="btn btn-primary btn-arrow btn-ripple">Explorar Produtos</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Conta",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
