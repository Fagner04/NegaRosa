{%- comment -%}
  Section: Category Grid
  Grid of category cards with image, overlay, and CTA
  UX inspirada em SiteMyrian: slideshow de 2 fotos, dots, badge, botão estilizado
{%- endcomment -%}

<section class="section-spacing catgrid-section" id="categories-{{ section.id }}" data-interval="{{ section.settings.slide_interval | times: 1000 }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="section-header reveal">
        <h2 class="section-header__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="category-grid category-grid--layout-{{ section.settings.layout }}" data-stagger-container>
      {%- for block in section.blocks -%}
        {%- assign has_two = false -%}
        {%- if block.settings.image != blank and block.settings.image_2 != blank -%}
          {%- assign has_two = true -%}
        {%- endif -%}

        <a href="{{ block.settings.link | default: '#' }}" class="category-card{% if has_two %} category-card--slideshow{% endif %}" style="--setup-i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="category-card__image-wrapper">
            {%- if block.settings.badge != blank -%}
              <span class="category-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              {%- if has_two -%}
                <img
                  class="category-card__image category-card__slide category-card__slide--active"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title | escape }}"
                  width="800"
                  height="600"
                  loading="lazy"
                >
              {%- else -%}
                <img
                  class="category-card__image"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title | escape }}"
                  width="800"
                  height="600"
                  loading="lazy"
                >
              {%- endif -%}
            {%- else -%}
              {%- if has_two -%}
                <div class="category-card__image category-card__slide category-card__slide--active category-card__image--placeholder" style="background: linear-gradient(135deg, #{{ block.settings.placeholder_color | default: '333333' }} 0%, #{{ block.settings.placeholder_color_2 | default: '666666' }} 100%);"></div>
              {%- else -%}
                <div class="category-card__image category-card__image--placeholder" style="background: linear-gradient(135deg, #{{ block.settings.placeholder_color | default: '333333' }} 0%, #{{ block.settings.placeholder_color_2 | default: '666666' }} 100%);"></div>
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.image_2 != blank -%}
              <img
                class="category-card__image category-card__slide"
                src="{{ block.settings.image_2 | image_url: width: 800 }}"
                alt="{{ block.settings.title | escape }}"
                width="800"
                height="600"
                loading="lazy"
              >
            {%- endif -%}

            {%- if has_two -%}
              <div class="category-card__dots">
                <span class="category-card__dot category-card__dot--active"></span>
                <span class="category-card__dot"></span>
              </div>
            {%- endif -%}

            <div class="category-card__overlay-content">
              <h3 class="category-card__title">{{ block.settings.title | default: 'Categoria' }}</h3>
              <span class="category-card__cta" style="background-color: {{ block.settings.btn_bg | default: '#ffffff' }}; color: {{ block.settings.btn_text_color | default: '#111111' }};">
                {{ block.settings.cta_text | default: 'Ver mais' }}
              </span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function () {
  var sections = document.querySelectorAll('.catgrid-section');
  sections.forEach(function (section) {
    var interval = parseInt(section.dataset.interval) || 3000;
    var cards = section.querySelectorAll('.category-card--slideshow');

    cards.forEach(function (card) {
      var slides = card.querySelectorAll('.category-card__slide');
      var dots   = card.querySelectorAll('.category-card__dot');
      if (slides.length < 2) return;
      var current = 0;

      setInterval(function () {
        slides[current].classList.remove('category-card__slide--active');
        dots[current] && dots[current].classList.remove('category-card__dot--active');
        current = (current + 1) % slides.length;
        slides[current].classList.add('category-card__slide--active');
        dots[current] && dots[current].classList.add('category-card__dot--active');
      }, interval);
    });
  });
})();
</script>

<script>
function initCategoryGsap(){
  if (window.matchMedia('(min-width: 769px)').matches) return;
  if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
  var sections = document.querySelectorAll('.catgrid-section');
  sections.forEach(function(section){
    var cards = section.querySelectorAll('.category-card');
    if (!cards.length) return;
    gsap.set(cards, {opacity:0, y:60});
    gsap.to(cards, {
      opacity:1,
      y:0,
      duration:0.7,
      ease:'power3.out',
      stagger:0.15,
      scrollTrigger:{
        trigger: section,
        start:'top 85%',
        once:true,
        toggleActions:'play none none none'
      }
    });
  });
}
if (document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', initCategoryGsap);
} else {
  initCategoryGsap();
}
</script>

{% schema %}
{
  "name": "Grid de Categorias",
  "class": "category-grid-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da seção",
      "default": "Explore por Categoria"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "1", "label": "3 colunas iguais" },
        { "value": "2", "label": "1 grande + 2 menores" },
        { "value": "3", "label": "1 destaque + 4 menores" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "slide_interval",
      "label": "Tempo entre fotos (segundos)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "info": "Aplicado em cards que têm 2 fotos"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Categoria"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (ex: Novo, Destaque)",
          "info": "Aparece no canto superior esquerdo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto 1",
          "info": "Recomendado: 800 x 600px."
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Foto 2 (opcional)",
          "info": "Se preenchida, alterna automaticamente com a Foto 1"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Texto do botão",
          "default": "Ver mais"
        },
        {
          "type": "color",
          "id": "btn_bg",
          "label": "Cor de fundo do botão",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Cor do texto do botão",
          "default": "#111111"
        },
        {
          "type": "text",
          "id": "placeholder_color",
          "label": "Cor placeholder 1 (hex sem #)",
          "default": "333333"
        },
        {
          "type": "text",
          "id": "placeholder_color_2",
          "label": "Cor placeholder 2 (hex sem #)",
          "default": "666666"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid de Categorias",
      "blocks": [
        { "type": "category", "settings": { "title": "Calçados", "placeholder_color": "1a1a2e", "placeholder_color_2": "16213e" } },
        { "type": "category", "settings": { "title": "Vestuário", "placeholder_color": "2d2d2d", "placeholder_color_2": "4a4a4a" } },
        { "type": "category", "settings": { "title": "Acessórios", "placeholder_color": "3d1a1a", "placeholder_color_2": "5a2d2d" } }
      ]
    }
  ]
}
{% endschema %}
