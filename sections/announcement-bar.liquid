{%- comment -%}
  Section: Announcement Bar (Marquee Infinito)
{%- endcomment -%}

{%- assign bg = section.settings.background_color | default: '#111111' -%}
{%- assign tc = section.settings.text_color | default: '#FFFFFF' -%}
{%- assign speed = section.settings.speed | default: 40 -%}

{%- assign items = section.blocks -%}

<div class="announcement-bar" style="background:{{bg}};color:{{tc}};">
  <div class="announcement-bar__viewport">
    {%- for i in (1..2) -%}
    <div class="announcement-bar__track" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" style="animation-duration: {{ speed }}s;">
      {%- if items.size > 0 -%}
        {%- for block in items -%}
          <div class="announcement-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__link">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
            <span class="announcement-bar__sep" aria-hidden="true">✦</span>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="announcement-bar__item"><span>FRETE GRÁTIS acima de R$299</span><span class="announcement-bar__sep">✦</span></div>
        <div class="announcement-bar__item"><span>PARCELE EM ATÉ 10X SEM JUROS</span><span class="announcement-bar__sep">✦</span></div>
        <div class="announcement-bar__item"><span>TROCA FÁCIL EM 7 DIAS</span><span class="announcement-bar__sep">✦</span></div>
        <div class="announcement-bar__item"><span>NOVA COLEÇÃO DISPONÍVEL</span><span class="announcement-bar__sep">✦</span></div>
      {%- endif -%}
    </div>
    {%- endfor -%}
  </div>
</div>

<style>
.announcement-bar{overflow:hidden;height:36px;position:relative;z-index:10;font-size:12px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase}
.announcement-bar__viewport{display:flex;height:100%;width:max-content;will-change:transform}
.announcement-bar__track{display:flex;align-items:center;flex-shrink:0;animation:announce-marquee linear infinite}
.announcement-bar__item{display:flex;align-items:center;gap:32px;padding:0 16px;white-space:nowrap}
.announcement-bar__link{color:inherit;text-decoration:none}
.announcement-bar__link:hover{text-decoration:underline;text-underline-offset:3px}
.announcement-bar__sep{opacity:.5;font-size:10px}
.announcement-bar:hover .announcement-bar__track{animation-play-state:paused}
@keyframes announce-marquee{from{transform:translateX(0)}to{transform:translateX(-100%)}}
@media(max-width:768px){.announcement-bar{font-size:10px;letter-spacing:1px;height:32px}}
@media(prefers-reduced-motion:reduce){.announcement-bar__track{animation:none}}
</style>

{% schema %}
{
  "name": "Barra de Anúncios",
  "class": "announcement-bar-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Velocidade (menor = mais rápido)",
      "min": 15,
      "max": 90,
      "step": 5,
      "default": 40,
      "unit": "s"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anúncio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto do anúncio",
          "default": "FRETE GRÁTIS acima de R$299"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de Anúncios",
      "blocks": [
        { "type": "announcement", "settings": { "text": "FRETE GRÁTIS acima de R$299" } },
        { "type": "announcement", "settings": { "text": "PARCELE EM ATÉ 10X SEM JUROS" } },
        { "type": "announcement", "settings": { "text": "TROCA FÁCIL EM 7 DIAS" } },
        { "type": "announcement", "settings": { "text": "NOVA COLEÇÃO DISPONÍVEL" } }
      ]
    }
  ]
}
{% endschema %}
