{%- comment -%}
  Section: Trust Badges
  Horizontal bar with benefits/trust icons (segurança, entrega, troca, etc)
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
<section class="trust-badges" style="--tb-bg: {{ section.settings.background_color }}; --tb-color: {{ section.settings.text_color }}; --tb-divider: {{ section.settings.divider_color }};">
  <div class="trust-badges__container">
    <ul class="trust-badges__list">
      {%- for i in (1..2) -%}
      <div class="trust-badges__track-group" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
      {%- for block in section.blocks -%}
        <li class="trust-badges__item" {{ block.shopify_attributes }}>
          <span class="trust-badges__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3z"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z"/></svg>
              {%- when 'refresh' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0115-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 01-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 01-11.6 7.1L4 20l1-4.4A8 8 0 1121 12z"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5.5 5.5 0 00-7.8 0L12 6.7l-1-1.1a5.5 5.5 0 10-7.8 7.8l1 1L12 22l7.8-7.6 1-1a5.5 5.5 0 000-7.8z"/></svg>
              {%- when 'medal' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="15" r="6"/><path d="M8 3l4 6 4-6"/></svg>
              {%- when 'card' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h3"/></svg>
              {%- when 'lock' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
              {%- when 'gift' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="5"/><path d="M5 13v8h14v-8M12 8v13M12 8s-3-5-6-3 2 3 6 3zM12 8s3-5 6-3-2 3-6 3z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>
            {%- endcase -%}
          </span>
          <span class="trust-badges__text">{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
      </div>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .trust-badges{
    background: var(--tb-bg, transparent);
    color: var(--tb-color, currentColor);
    border-top: 1px solid var(--tb-divider, rgba(0,0,0,.06));
    border-bottom: 1px solid var(--tb-divider, rgba(0,0,0,.06));
    padding: 18px 0;
  }
  .trust-badges__container{
    max-width: var(--container-max, 1440px);
    margin: 0 auto;
    padding: 0 var(--space-4, 24px);
  }
  .trust-badges__list{
    list-style: none;
    margin: 0; padding: 0;
    display: flex; align-items: center; justify-content: center;
    gap: 4px;
    flex-wrap: nowrap;
    scrollbar-width: none;
  }
  .trust-badges__list::-webkit-scrollbar{ display: none; }
  .trust-badges__track-group{
    display: contents;
  }
  .trust-badges__track-group + .trust-badges__track-group{ display: none; }
  .trust-badges__item{
    flex: 0 1 auto;
    display: flex; align-items: center; gap: 6px;
    justify-content: center;
    padding: 4px 8px;
    border-right: 1px solid var(--tb-divider, rgba(0,0,0,.08));
    font-family: var(--font-ui, inherit);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .01em;
    white-space: nowrap;
  }
  .trust-badges__item:last-child{ border-right: 0; }
  .trust-badges__icon{
    width: 16px; height: 16px;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .trust-badges__icon svg{ width: 100%; height: 100%; }

  @media (max-width: 900px){
    .trust-badges{ padding: 12px 0; }
    .trust-badges__container{ padding: 0; }
    .trust-badges__list{
      justify-content: flex-start;
      gap: 0;
      flex-wrap: nowrap;
      width: max-content;
      animation: trust-badges-marquee 28s linear infinite;
    }
    .trust-badges__track-group{ display: flex; align-items: center; flex-shrink: 0; }
    .trust-badges__track-group + .trust-badges__track-group{ display: flex; }
    .trust-badges__item{
      flex: 0 0 auto;
      font-size: 12px;
      padding: 4px 18px;
      border-right: 1px solid var(--tb-divider, rgba(0,0,0,.08));
    }
    .trust-badges__item:last-child{ border-right: 1px solid var(--tb-divider, rgba(0,0,0,.08)); }
  }
  @keyframes trust-badges-marquee{
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce){
    .trust-badges__list{ animation: none; }
  }
</style>

{%- endif -%}

{% schema %}
{
  "name": "Barra de Benefícios",
  "tag": "section",
  "class": "trust-badges-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#F7F4EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Cor do divisor",
      "default": "#E5DDD2"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Benefício",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Escudo (Segurança)" },
            { "value": "lock",   "label": "Cadeado" },
            { "value": "truck",  "label": "Caminhão (Entrega)" },
            { "value": "refresh","label": "Troca / Devolução" },
            { "value": "chat",   "label": "Suporte (Chat)" },
            { "value": "heart",  "label": "Coração (Originais)" },
            { "value": "medal",  "label": "Medalha (Qualidade)" },
            { "value": "card",   "label": "Cartão (Parcelamento)" },
            { "value": "gift",   "label": "Presente" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Benefício"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de Benefícios",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shield",  "text": "Compra Segura" } },
        { "type": "badge", "settings": { "icon": "truck",   "text": "Entrega Rápida" } },
        { "type": "badge", "settings": { "icon": "refresh", "text": "Troca em 7 dias" } },
        { "type": "badge", "settings": { "icon": "chat",    "text": "Suporte das 09h às 18h" } },
        { "type": "badge", "settings": { "icon": "heart",   "text": "Produtos Originais" } },
        { "type": "badge", "settings": { "icon": "card",    "text": "Parcele em até 6x sem juros" } }
      ]
    }
  ]
}
{% endschema %}
