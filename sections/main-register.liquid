{%- comment -%}
  Section: Main Register
  Customer account registration form
{%- endcomment -%}

<section class="account-section" style="padding-top: var(--space-16); padding-bottom: var(--space-16);">
  <div class="page-width">
    <div style="max-width: 440px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-6);">
      <h1 style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-extrabold); text-transform: uppercase; text-align: center;">Criar Conta</h1>
      <p style="font-size: var(--font-size-sm); color: var(--color-text-light); text-align: center; margin-top: calc(var(--space-2) * -1);">Junte-se à ConectWhats e aproveite benefícios exclusivos</p>

      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div style="background-color: #fff2f2; border: 1px solid #ffcccc; border-radius: var(--border-radius-sm); padding: var(--space-3) var(--space-4); font-size: var(--font-size-sm); color: #cc0000;" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="display: flex; flex-direction: column; gap: var(--space-4);">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
            <div>
              <label for="FirstName" style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: var(--space-1);">Nome</label>
              <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name" placeholder="João"
                style="width:100%; height:48px; padding: 0 var(--space-4); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font-size: var(--font-size-base); background: var(--color-bg); color: var(--color-text); outline: none;">
            </div>
            <div>
              <label for="LastName" style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: var(--space-1);">Sobrenome</label>
              <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name" placeholder="Silva"
                style="width:100%; height:48px; padding: 0 var(--space-4); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font-size: var(--font-size-base); background: var(--color-bg); color: var(--color-text); outline: none;">
            </div>
          </div>

          <div>
            <label for="RegisterEmail" style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: var(--space-1);">E-mail</label>
            <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="seu@email.com" required
              style="width:100%; height:48px; padding: 0 var(--space-4); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font-size: var(--font-size-base); background: var(--color-bg); color: var(--color-text); outline: none;">
          </div>

          <div>
            <label for="RegisterPassword" style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: var(--space-1);">Senha</label>
            <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" placeholder="Mínimo 5 caracteres" required
              style="width:100%; height:48px; padding: 0 var(--space-4); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); font-size: var(--font-size-base); background: var(--color-bg); color: var(--color-text); outline: none;">
          </div>

          <button type="submit" class="btn btn-primary btn-ripple" style="height: 52px; font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: 0.05em; margin-top: var(--space-2); width: 100%;">
            Criar Conta
          </button>
        </div>
      {%- endform -%}

      <p style="font-size: var(--font-size-sm); text-align: center; color: var(--color-text-light);">
        Já tem conta? <a href="/account/login" style="color: var(--color-text); font-weight: var(--font-weight-semibold); text-decoration: underline;">Entrar</a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cadastro",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
