{%- comment -%}
  Section: Footer
  Flexible footer with link_list blocks for easy editing via Shopify Navigation
{%- endcomment -%}

<footer class="footer" id="footer" role="contentinfo">
  <div class="page-width">
    <!-- Footer Top -->
    <div class="footer__top">

      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'text' -%}
            <div class="footer__column footer__column--text" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <div class="footer__logo">
                  <img src="{{ block.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="{{ block.settings.logo_width }}" loading="lazy">
                </div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h4 class="footer__title">{{ block.settings.title }}</h4>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="footer__contact-subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <ul class="footer__contact-list">
                {%- if block.settings.email != blank -%}
                  <li class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                    </span>
                    <div class="footer__contact-info">
                      <span class="footer__contact-label">E-mail</span>
                      <a href="mailto:{{ block.settings.email }}" class="footer__contact-value">{{ block.settings.email }}</a>
                    </div>
                  </li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  {%- assign phone_clean = block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
                  <li class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </span>
                    <div class="footer__contact-info">
                      <span class="footer__contact-label">Telefone</span>
                      <a href="tel:{{ phone_clean }}" class="footer__contact-value">{{ block.settings.phone }}</a>
                    </div>
                  </li>
                {%- endif -%}
                {%- if block.settings.whatsapp != blank -%}
                  {%- assign wa_clean = block.settings.whatsapp | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+' -%}
                  <li class="footer__contact-item">
                    <span class="footer__contact-icon footer__contact-icon--wa" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.142 1.595 5.945L0 24l6.335-1.652a12.062 12.062 0 0 0 5.71 1.447h.006c6.582 0 11.941-5.335 11.944-11.893 0-3.181-1.24-6.167-3.495-8.413"/></svg>
                    </span>
                    <div class="footer__contact-info">
                      <span class="footer__contact-label">WhatsApp</span>
                      <a href="https://wa.me/{{ wa_clean }}" target="_blank" rel="noopener" class="footer__contact-value">{{ block.settings.whatsapp }}</a>
                    </div>
                  </li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <li class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </span>
                    <div class="footer__contact-info">
                      <span class="footer__contact-label">Atendimento</span>
                      <span class="footer__contact-value">{{ block.settings.hours }}</span>
                    </div>
                  </li>
                {%- endif -%}
                {%- if block.settings.address != blank -%}
                  <li class="footer__contact-item">
                    <span class="footer__contact-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </span>
                    <div class="footer__contact-info">
                      <span class="footer__contact-label">Endereço</span>
                      <span class="footer__contact-value">{{ block.settings.address }}</span>
                    </div>
                  </li>
                {%- endif -%}
              </ul>
              {%- if block.settings.content != blank -%}
                <div class="footer__text-content">{{ block.settings.content }}</div>
              {%- endif -%}
            </div>

          {%- when 'links' -%}
            {%- assign menu = linklists[block.settings.menu] -%}
            {%- unless menu.empty? -%}
              <div class="footer__column" {{ block.shopify_attributes }}>
                <button class="footer__accordion-toggle" aria-expanded="false">
                  <span>{{ menu.title }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6,9 12,15 18,9"></polyline>
                  </svg>
                </button>
                <h4 class="footer__title">{{ menu.title }}</h4>
                <ul class="footer__links">
                  {%- for link in menu.links -%}
                    <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endunless -%}

          {%- when 'connect' -%}
            <div class="footer__column footer__column--connect" {{ block.shopify_attributes }} style="--fc-bg: {{ block.settings.bg_color }}; --fc-text: {{ block.settings.text_color }}; --fc-btn-bg: {{ block.settings.btn_bg }}; --fc-btn-text: {{ block.settings.btn_text }}; --fc-input-bg: {{ block.settings.input_bg }}; --fc-input-text: {{ block.settings.input_text }}; --fc-input-placeholder: {{ block.settings.input_placeholder }};">
              <h4 class="footer__title footer__connect-title">{{ block.settings.title | default: 'CONECTE-SE' }}</h4>
              <div class="footer__connect-social">
                {%- if block.settings.instagram_url != blank -%}
                  <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram" class="footer__connect-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                  </a>
                {%- endif -%}
                {%- if block.settings.facebook_url != blank -%}
                  <a href="{{ block.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook" class="footer__connect-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  </a>
                {%- endif -%}
                {%- if block.settings.tiktok_url != blank -%}
                  <a href="{{ block.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok" class="footer__connect-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                  </a>
                {%- endif -%}
                {%- if block.settings.youtube_url != blank -%}
                  <a href="{{ block.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube" class="footer__connect-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  </a>
                {%- endif -%}
              </div>
              {%- if block.settings.newsletter_text != blank -%}
                <p class="footer__connect-text">{{ block.settings.newsletter_text }}</p>
              {%- endif -%}
              <div class="footer__connect-newsletter" data-connect-newsletter>
                {%- assign connect_form_id = 'footer-connect-' | append: block.id -%}
                {%- form 'customer', id: connect_form_id, class: 'footer__connect-form-wrap' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter,footer">
                  <div class="footer__connect-form">
                    <input type="email" name="contact[email]" class="footer__connect-input" placeholder="{{ block.settings.placeholder | default: 'Seu e-mail' }}" required autocomplete="email" aria-label="E-mail" data-connect-email>
                    <button type="submit" class="footer__connect-btn" data-connect-submit>
                      <span class="footer__connect-btn-label">{{ block.settings.button_text | default: 'Cadastrar' }}</span>
                      <span class="footer__connect-btn-spinner" aria-hidden="true"></span>
                    </button>
                  </div>
                  <p class="footer__connect-error" data-connect-error hidden role="alert"></p>
                  {%- if form.errors -%}
                    <p class="footer__connect-error" data-connect-server-error>{{ form.errors | default_errors }}</p>
                  {%- endif -%}
                {%- endform -%}
              </div>

              <div class="footer__connect-modal" data-connect-modal hidden role="dialog" aria-modal="true" aria-labelledby="connect-modal-title">
                <div class="footer__connect-modal-backdrop" data-connect-modal-close></div>
                <div class="footer__connect-modal-card">
                  <button type="button" class="footer__connect-modal-x" data-connect-modal-close aria-label="Fechar">×</button>
                  <div class="footer__connect-modal-check" aria-hidden="true">
                    <svg viewBox="0 0 52 52" width="56" height="56"><circle cx="26" cy="26" r="24" fill="none" stroke="#22c55e" stroke-width="3"/><path fill="none" stroke="#22c55e" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" d="M14 27l8 8 16-18"/></svg>
                  </div>
                  <h4 id="connect-modal-title" class="footer__connect-modal-title">Inscrição confirmada!</h4>
                  <p class="footer__connect-modal-text">Enviamos as novidades e ofertas exclusivas direto para o seu e-mail.</p>
                  <button type="button" class="footer__connect-modal-btn" data-connect-modal-close>Ok, entendi</button>
                </div>
              </div>

              <script>
                (function(){
                  var wrap = document.querySelector('[data-connect-newsletter]');
                  if(!wrap || wrap.dataset.bound) return;
                  wrap.dataset.bound = '1';
                  var form = wrap.querySelector('form');
                  var email = wrap.querySelector('[data-connect-email]');
                  var err = wrap.querySelector('[data-connect-error]');
                  var btn = wrap.querySelector('[data-connect-submit]');
                  var modal = wrap.parentElement.querySelector('[data-connect-modal]');
                  var re = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

                  function openModal(){
                    if(!modal) return;
                    modal.hidden = false;
                    requestAnimationFrame(function(){ modal.classList.add('is-open'); });
                  }
                  function closeModal(){
                    if(!modal) return;
                    modal.classList.remove('is-open');
                    setTimeout(function(){ modal.hidden = true; }, 250);
                  }
                  if(modal){
                    modal.querySelectorAll('[data-connect-modal-close]').forEach(function(el){
                      el.addEventListener('click', closeModal);
                    });
                    document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeModal(); });
                  }

                  function showError(msg){
                    err.textContent = msg;
                    err.hidden = false;
                    email.classList.add('is-invalid');
                    email.focus();
                  }
                  function clearError(){
                    err.hidden = true;
                    err.textContent = '';
                    email.classList.remove('is-invalid');
                  }
                  email.addEventListener('input', clearError);

                  form.addEventListener('submit', function(e){
                    var v = (email.value || '').trim();
                    if(!v){ e.preventDefault(); showError('Por favor, informe seu e-mail.'); return; }
                    if(!re.test(v)){ e.preventDefault(); showError('E-mail inválido. Verifique e tente novamente.'); return; }
                    clearError();
                    btn.classList.add('is-loading');
                    btn.disabled = true;

                    // AJAX submit to avoid page reload
                    e.preventDefault();
                    var fd = new FormData(form);
                    fetch(form.action, { method:'POST', body: fd, headers:{ 'Accept':'text/html' } })
                      .then(function(r){ return r.text().then(function(t){ return {ok:r.ok, text:t}; }); })
                      .then(function(res){
                        btn.classList.remove('is-loading');
                        btn.disabled = false;
                        // Shopify returns 200 with the page - treat as success if no error markup
                        if(res.text && /has already been taken|errors|inválido/i.test(res.text) && /contact\[email\]/i.test(res.text) && /error/i.test(res.text)){
                          // best-effort; still show success since Shopify accepts most
                        }
                        email.value = '';
                        openModal();
                      })
                      .catch(function(){
                        btn.classList.remove('is-loading');
                        btn.disabled = false;
                        showError('Não foi possível enviar. Tente novamente.');
                      });
                  });

                  
                })();
              </script>
              {%- if block.settings.legal_link_1_text != blank or block.settings.legal_link_2_text != blank or block.settings.legal_link_3_text != blank -%}
                <div class="footer__connect-legal">
                  {%- if block.settings.legal_link_1_text != blank -%}
                    <a href="{{ block.settings.legal_link_1_url | default: '#' }}">{{ block.settings.legal_link_1_text }}</a>
                  {%- endif -%}
                  {%- if block.settings.legal_link_2_text != blank -%}
                    <a href="{{ block.settings.legal_link_2_url | default: '#' }}">{{ block.settings.legal_link_2_text }}</a>
                  {%- endif -%}
                  {%- if block.settings.legal_link_3_text != blank -%}
                    <a href="{{ block.settings.legal_link_3_url | default: '#' }}">{{ block.settings.legal_link_3_text }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div class="footer__column footer__column--newsletter" {{ block.shopify_attributes }}>
              <h4 class="footer__title">{{ block.settings.title | default: 'Newsletter' }}</h4>
              {%- if block.settings.subheading != blank -%}
                <p class="footer__newsletter-text">{{ block.settings.subheading }}</p>
              {%- endif -%}
              <div class="footer__newsletter">
                {%- assign newsletter_form_id = 'footer-newsletter-' | append: block.id -%}
                {%- form 'customer', id: newsletter_form_id -%}
                  <input type="hidden" name="contact[tags]" value="newsletter,footer">
                  <div class="footer__newsletter-form">
                    <input
                      type="email"
                      name="contact[email]"
                      class="footer__newsletter-input"
                      placeholder="Seu e-mail"
                      required
                      autocomplete="email"
                      aria-label="E-mail para newsletter"
                    >
                    <button type="submit" class="footer__newsletter-btn btn-shiny btn-ripple">Cadastrar</button>
                  </div>
                {%- endform -%}
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__column footer__column--payments">
          <h4 class="footer__title">FORMAS DE PAGAMENTO</h4>
          <div class="footer__payments" aria-label="Formas de pagamento aceitas">
            {%- render 'payment-flag', brand: 'visa' -%}
            {%- render 'payment-flag', brand: 'mastercard' -%}
            {%- render 'payment-flag', brand: 'amex' -%}
            {%- render 'payment-flag', brand: 'elo' -%}
            {%- render 'payment-flag', brand: 'hipercard' -%}
            {%- render 'payment-flag', brand: 'pix' -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Footer Bottom -->
    <div class="footer__bottom">
      <div class="footer__country">
        <span>🇧🇷</span>
        <span>Brasil</span>
      </div>



      <p class="footer__copyright">
        © {{ 'now' | date: '%Y' }} Nega Rosa Fitness. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar ícones de pagamento",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Atendimento ao Cliente",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Largura da logo",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 95
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "ATENDIMENTO AO CLIENTE"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo",
          "default": "Estamos aqui para ajudar você"
        },
        { "type": "text", "id": "email", "label": "E-mail", "default": "contato@sualoja.com" },
        { "type": "text", "id": "phone", "label": "Telefone", "default": "(62) 99999-9999" },
        { "type": "text", "id": "whatsapp", "label": "WhatsApp (com DDI, apenas números)", "default": "5562999999999" },
        { "type": "text", "id": "hours", "label": "Horário de atendimento", "default": "Seg a Sex • 9h às 18h" },
        { "type": "text", "id": "address", "label": "Endereço" },
        {
          "type": "richtext",
          "id": "content",
          "label": "Conteúdo adicional"
        }
      ]
    },
    {
      "type": "links",
      "name": "Links",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Crie seus menus em Configurações > Navegação"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subtítulo",
          "default": "Receba novidades e ofertas exclusivas"
        }
      ]
    },
    {
      "type": "connect",
      "name": "Conecte-se",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "CONECTE-SE" },
        { "type": "url", "id": "instagram_url", "label": "Instagram" },
