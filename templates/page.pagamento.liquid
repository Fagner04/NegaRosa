{%- comment -%}
  Template: Página de Pagamento
  Página para instruir clientes sobre formas de pagamento
{%- endcomment -%}

<div class="page-width">
  <div class="payment-page">
    <h1 class="payment-page__title">Formas de Pagamento</h1>

    <div class="payment-methods">
      <div class="payment-method">
        <div class="payment-method__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        </div>
        <div class="payment-method__info">
          <h3>Cartão de Crédito</h3>
          <p>Até <strong>6x sem juros</strong> no cartão de crédito</p>
          <span class="payment-method__badge">Parcele sua compra!</span>
        </div>
      </div>

      <div class="payment-method">
        <div class="payment-method__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="payment-method__info">
          <h3>PIX</h3>
          <p>Pagamento à vista com <strong>10% de desconto</strong></p>
          <span class="payment-method__badge">Aprovação instantânea</span>
        </div>
      </div>

      <div class="payment-method">
        <div class="payment-method__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
        <div class="payment-method__info">
          <h3>Boleto Bancário</h3>
          <p>Pagamento à vista em até <strong>3 dias úteis</strong></p>
          <span class="payment-method__badge">Sem cadastro</span>
        </div>
      </div>
    </div>

    <div class="payment-security">
      <div class="payment-security__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <div class="payment-security__text">
        <h4>Compra 100% Segura</h4>
        <p>Todas as transações são protegidas com criptografia SSL. Seus dados estão seguros conosco.</p>
      </div>
    </div>

    <div class="payment-doubts">
      <h2>Dúvidas Frequentes</h2>

      <details class="payment-faq">
        <summary>Como parcelo minha compra?</summary>
        <p>Na hora do pagamento, selecione a opção "Cartão de Crédito" e escolha o número de parcelas desejado. O parcelamento é feito direto no checkout.</p>
      </details>

      <details class="payment-faq">
        <summary>O PIX é seguro?</summary>
        <p>Sim! O PIX é uma forma de pagamento regulamentada pelo Banco Central. O pagamento é confirmado em instantes e sua compra é processada imediatamente.</p>
      </details>

      <details class="payment-faq">
        <summary>Posso trocar a forma de pagamento depois?</summary>
        <p>Caso precise alterar, entre em contato conosco via WhatsApp antes do envio do pedido.</p>
      </details>
    </div>

    <div class="payment-cta">
      <a href="https://wa.me/5562999999999?text=Olá! Tenho uma dúvida sobre pagamento" class="btn-shiny btn-ripple" target="_blank">
        Falar no WhatsApp
      </a>
    </div>
  </div>
</div>

<style>
  .payment-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .payment-page__title {
    text-align: center;
    font-size: 2rem;
    color: var(--color-text);
    margin-bottom: 40px;
  }

  .payment-methods {
    display: grid;
    gap: 20px;
    margin-bottom: 40px;
  }

  .payment-method {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    background: var(--color-bg-secondary);
    border-radius: 12px;
    transition: transform 0.2s;
  }

  .payment-method:hover {
    transform: translateY(-2px);
  }

  .payment-method__icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    border-radius: 12px;
    flex-shrink: 0;
  }

  .payment-method__icon svg {
    width: 30px;
    height: 30px;
    stroke: white;
  }

  .payment-method__info h3 {
    font-size: 1.2rem;
    color: var(--color-text);
    margin: 0 0 4px;
  }

  .payment-method__info p {
    color: var(--color-text-light);
    margin: 0 0 8px;
  }

  .payment-method__badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--color-accent);
    color: white;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .payment-security {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    margin-bottom: 40px;
  }

  .payment-security__icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #22c55e;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .payment-security__icon svg {
    width: 24px;
    height: 24px;
    stroke: white;
  }

  .payment-security__text h4 {
    color: #166534;
    margin: 0 0 4px;
  }

  .payment-security__text p {
    color: #15803d;
    margin: 0;
    font-size: 0.9rem;
  }

  .payment-doubts {
    margin-bottom: 40px;
  }

  .payment-doubts h2 {
    font-size: 1.5rem;
    color: var(--color-text);
    margin-bottom: 20px;
  }

  .payment-faq {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .payment-faq summary {
    padding: 16px 20px;
    background: var(--color-bg-secondary);
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
  }

  .payment-faq[open] summary {
    border-bottom: 1px solid var(--color-border);
  }

  .payment-faq p {
    padding: 16px 20px;
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.6;
  }

  .payment-cta {
    text-align: center;
  }
</style>

{% schema %}
{
  "name": "Página Pagamento",
  "class": "page-section",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Número WhatsApp",
      "default": "5562999999999"
    }
  ]
}
{% endschema %}
