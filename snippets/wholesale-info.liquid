{%- comment -%}
  Snippet: wholesale-info — Snippet 2 (Página do Produto)
  Versão detalhada com preço grande, quantidade mínima e valor mínimo do pedido.
  Aparece quando o cliente abre o produto.

  Uso:
    {% render 'wholesale-info', product: product %}

  Lê os metafields (criados pelo botão "Atacado → Shopify"):
    custom.wholesale_price     — Preço de atacado (money, decimal ou texto)
    custom.wholesale_min_qty   — Quantidade mínima (integer)
    custom.wholesale_min_value — Valor mínimo do pedido (money ou decimal)
  Aceita ainda o legado custom.preco_atacado como fallback.

  Exibe somente quando houver preço de atacado válido.
  (No tema NegaRosa o equivalente nativo vive em sections/main-product.liquid,
  bloco .wholesale-card — este snippet é para uso manual em outros templates.)
{%- endcomment -%}

{%- assign ws_product = product | default: card_product -%}
{%- assign ws_raw = ws_product.metafields.custom.wholesale_price | default: ws_product.metafields.custom.preco_atacado -%}
{%- assign ws_value = ws_raw.value | default: ws_raw -%}
{%- assign ws_is_money = false -%}
{%- if ws_value.amount -%}
  {%- assign ws_is_money = true -%}
{%- endif -%}
{%- assign ws_cents = 0 -%}
{%- unless ws_is_money -%}
  {%- assign ws_str = ws_value | append: '' | replace: ' ', '' | replace: 'R$', '' -%}
  {%- if ws_str contains ',' -%}
    {%- assign ws_str = ws_str | replace: '.', '' | replace: ',', '.' -%}
  {%- endif -%}
  {%- assign ws_num = ws_str | times: 1.0 -%}
  {%- if ws_num > 0 -%}
    {%- assign ws_cents = ws_num | times: 100 | round -%}
  {%- endif -%}
{%- endunless -%}
{%- assign ws_min_qty = ws_product.metafields.custom.wholesale_min_qty.value | default: ws_product.metafields.custom.wholesale_min_qty -%}
{%- assign ws_min_value_raw = ws_product.metafields.custom.wholesale_min_value -%}
{%- assign ws_min_value = ws_min_value_raw.value | default: ws_min_value_raw -%}
{%- assign ws_min_value_is_money = false -%}
{%- if ws_min_value.amount -%}
  {%- assign ws_min_value_is_money = true -%}
{%- endif -%}
{%- assign ws_min_value_cents = 0 -%}
{%- unless ws_min_value_is_money -%}
  {%- assign ws_mv_str = ws_min_value | append: '' | replace: ' ', '' | replace: 'R$', '' -%}
  {%- if ws_mv_str contains ',' -%}
    {%- assign ws_mv_str = ws_mv_str | replace: '.', '' | replace: ',', '.' -%}
  {%- endif -%}
  {%- assign ws_mv_num = ws_mv_str | times: 1.0 -%}
  {%- if ws_mv_num > 0 -%}
    {%- assign ws_min_value_cents = ws_mv_num | times: 100 | round -%}
  {%- endif -%}
{%- endunless -%}

{%- if ws_is_money or ws_cents > 0 -%}
  <div class="wholesale-info wholesale-card" style="display: flex; align-items: flex-start; gap: 10px; margin: 8px 0 2px; padding: 10px 12px; background: #FFF7ED; border: 1px solid #FDBA74; border-radius: 12px; font-size: 12px;">
    <span style="width: 30px; height: 30px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; background: rgba(194,65,12,0.12); color: #C2410C;" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
    </span>
    <div style="display: flex; flex-direction: column; gap: 2px; min-width: 0;">
      <div style="display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px; color: #9A3412;">
        <span style="font-weight: 600;">Atacado:</span>
        <strong style="color: #C2410C; font-size: 16px; font-weight: 800;">{%- if ws_is_money -%}{{ ws_value | money }}{%- else -%}{{ ws_cents | money }}{%- endif -%}</strong>
        {%- if ws_min_qty != blank -%}
          <span>(mín. {{ ws_min_qty }} un.)</span>
        {%- endif -%}
      </div>
      {%- if ws_min_value_is_money -%}
        <span style="font-size: 11px; color: #B45309;">Pedido mínimo: {{ ws_min_value | money }}</span>
      {%- elsif ws_min_value_cents > 0 -%}
        <span style="font-size: 11px; color: #B45309;">Pedido mínimo: {{ ws_min_value_cents | money }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
