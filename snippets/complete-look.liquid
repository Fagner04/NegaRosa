{%- comment -%}
  Snippet: complete-look
  Card "Monte o Look" a partir do metafield custom.complete_o_look (lista de produtos).
  Layout igual ao seletor principal (bloco): TAMANHO primeiro, depois COR.
  Tamanhos indisponíveis na cor atual ficam com X (classe .unavailable).
{%- endcomment -%}

{%- assign look_products = product.metafields.custom.complete_o_look.value | default: product.metafields.custom.complete_o_look -%}
{%- if look_products != blank and look_products.size > 0 -%}

<div class="look-card" data-look-card>
  <h3 class="look-card__title">Monte o look</h3>
  <div class="look-list">
    {%- for lp in look_products -%}
      {%- if lp.title != blank -%}
        {%- assign lp_color_idx = nil -%}
        {%- assign lp_size_idx = nil -%}
        {%- assign lp_color_name = 'Cor' -%}
        {%- assign lp_size_name = 'Tamanho' -%}
        {%- for opt in lp.options_with_values -%}
          {%- assign on = opt.name | downcase -%}
          {%- if on == 'cor' or on == 'color' or on == 'colour' or on == 'cores' -%}
            {%- assign lp_color_idx = forloop.index0 -%}
            {%- assign lp_color_name = opt.name -%}
          {%- elsif on contains 'tamanho' or on contains 'size' -%}
            {%- assign lp_size_idx = forloop.index0 -%}
            {%- assign lp_size_name = opt.name -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign lp_def = lp.selected_or_first_available_variant -%}
        {%- if lp_def == nil -%}
          {%- for v in lp.variants -%}{%- if v.available -%}{%- assign lp_def = v -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- endif -%}
        {%- if lp_def == nil -%}{%- assign lp_def = lp.variants.first -%}{%- endif -%}
        {%- capture lp_stock -%}{%- for v in lp.variants -%}{% unless forloop.first %},{% endunless %}"{{ v.id }}":{"q":{{ v.inventory_quantity | default: 0 }},"p":"{{ v.inventory_policy }}","m":{% if v.inventory_management %}1{% else %}0{% endif %}}{%- endfor -%}{%- endcapture -%}
        <div class="look-item" data-look-item data-handle="{{ lp.handle }}" data-color-idx="{{ lp_color_idx }}" data-size-idx="{{ lp_size_idx }}" data-stock='{ {{ lp_stock }} }'>
          <a class="look-item__img" href="{{ lp.url }}">
            {%- if lp.featured_image != blank -%}
              <img src="{{ lp.featured_image | image_url: width: 300 }}" alt="{{ lp.title | escape }}" width="300" height="300" loading="lazy">
            {%- endif -%}
          </a>
          <div class="look-item__info">
            <span class="look-item__title">{{ lp.title }}</span>
            <span class="look-item__price">{{ lp.price | money }}</span>

            {%- comment -%} 1) TAMANHO primeiro {%- endcomment -%}
            {%- if lp_size_idx != nil -%}
              {%- assign def_color_val = lp_def.options[lp_color_idx] -%}
              <div class="look-opt" data-look-opt="size">
                <span class="option-selector__label">{{ lp_size_name }}: <span class="option-selector__selected" data-look-selected-size>{{ lp_def.options[lp_size_idx] }}</span></span>
                <div class="size-grid" data-look-sizes>
                  {%- for value in lp.options_with_values[lp_size_idx].values -%}
                    {%- assign has_av_color = false -%}
                    {%- for v in lp.variants -%}
                      {%- if v.options[lp_size_idx] == value and v.available -%}
                        {%- if lp_color_idx == nil or v.options[lp_color_idx] == def_color_val -%}
                          {%- assign has_av_color = true -%}{%- break -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <button type="button"
                      class="size-button{% if lp_def.options[lp_size_idx] == value %} active{% endif %}{% unless has_av_color %} unavailable{% endunless %}"
                      data-look-size data-value="{{ value | escape }}"{% unless has_av_color %} title="Esgotado nesta cor"{% endunless %}>{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

            {%- comment -%} 2) COR depois {%- endcomment -%}
            {%- if lp_color_idx != nil -%}
              {%- assign def_size_val = lp_def.options[lp_size_idx] -%}
              <div class="look-opt" data-look-opt="color">
                <span class="option-selector__label">{{ lp_color_name }}: <span class="option-selector__selected" data-look-selected-color>{{ lp_def.options[lp_color_idx] }}</span></span>
                <div class="size-grid" data-look-colors>
                  {%- for value in lp.options_with_values[lp_color_idx].values -%}
                    {%- assign has_av_size = false -%}
                    {%- for v in lp.variants -%}
                      {%- if v.options[lp_color_idx] == value and v.available -%}
                        {%- if lp_size_idx == nil or v.options[lp_size_idx] == def_size_val -%}
                          {%- assign has_av_size = true -%}{%- break -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <button type="button"
                      class="size-button{% if lp_def.options[lp_color_idx] == value %} active{% endif %}{% unless has_av_size %} unavailable{% endunless %}"
                      data-look-color data-value="{{ value | escape }}"{% unless has_av_size %} disabled title="Esgotado neste tamanho"{% endunless %}>{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
          <button type="button" class="look-add" data-look-add="{{ lp_def.id }}">Adicionar</button>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>
  .look-card {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border: none;
    border-radius: 16px;
    background: var(--color-bg, #fff);
    box-shadow: none;
  }
  .look-card__title {
    font-size: var(--font-size-base);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-3);
  }
  .look-list { display: flex; flex-direction: column; gap: 10px; }
  .look-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border: none;
    border-radius: 12px;
    background: var(--color-bg, #fff);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.05);
  }
  .look-item__img { width: 92px; height: 104px; border-radius: 10px; overflow: hidden; flex-shrink: 0; background: var(--color-bg-secondary); align-self: flex-start; }
  .look-item__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .look-item__info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .look-item__title { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .look-item__price { font-size: 13px; font-weight: 600; color: #7F1D1D; }
  /* Reaproveita o visual do produto principal (size-grid/size-button).
     Fallback escopado caso o CSS do main-product mude. */
  .look-item .option-selector__label {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    display: flex;
    justify-content: flex-start;
    gap: 4px;
  }
  .look-item .option-selector__selected {
    font-weight: 400;
    color: var(--color-text-light);
    text-transform: none;
  }
  .look-item .size-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .look-item .size-button {
    height: 30px;
    min-width: 48px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    transition: all var(--transition-fast);
    background: #fff;
    cursor: pointer;
    position: relative;
  }
  .look-item .size-button.active {
    border-color: #111;
    background-color: #111;
    color: #fff;
  }
  .look-item .size-button.unavailable {
    opacity: 0.45;
    background-color: #fff;
    color: #a3a3a3;
    position: relative;
  }
  .look-item .size-button.unavailable::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    top: 50%;
    height: 1px;
    background: #d4d4d4;
    transform: rotate(-18deg);
    pointer-events: none;
  }
  .look-item [data-look-opt="color"] .size-button.unavailable { cursor: not-allowed; }
  .look-add {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #111;
    border: 1px solid #111;
    color: #fff;
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.16);
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease, opacity 0.2s ease;
    white-space: nowrap;
  }
  .look-add:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.22);
    background: #000;
  }
  .look-add:active:not(:disabled) { transform: scale(0.97); }
  .look-add:disabled { opacity: 0.5; cursor: not-allowed; }
  .look-add.added { background: #16a34a; border-color: #16a34a; color: #fff; }
  /* Efeito voando p/ sacola */
  .nr-fly-img {
    position: fixed;
    z-index: 9999;
    pointer-events: none;
    border-radius: 12px;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.5, -0.1, 0.3, 1), opacity 0.7s ease, width 0.7s ease, height 0.7s ease;
    will-change: transform, opacity;
  }
  @keyframes nrBagPop {
    0% { transform: scale(1); }
    40% { transform: scale(1.25) rotate(-8deg); }
    100% { transform: scale(1); }
  }
  .header__cart-btn.nr-bump { animation: nrBagPop 0.5s ease; }
  /* Toast fallback (o principal está no main-product) */
  #NrToast.nr-toast-fallback {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%) translateY(16px);
    max-width: min(92vw, 420px);
    background: #1A1A1A;
    color: #FFFFFF;
    font-size: 13px;
    line-height: 1.4;
    padding: 10px 16px;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(0,0,0,.25);
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s, transform .25s;
    z-index: 9999;
    text-align: center;
  }
  #NrToast.nr-toast-fallback.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @media (max-width: 480px) {
    .look-card { padding: var(--space-3); }
    .look-item { flex-wrap: wrap; }
    .look-item__img { width: 56px; height: 64px; }
    .look-item__info { flex: 1 1 calc(100% - 66px); }
    .look-add { flex: 1 1 100%; padding: 10px; }
  }
</style>

<script>
(function () {
  if (window.__nrLookBound) return;
  window.__nrLookBound = true;

  var prodCache = {};
  function getProd(handle, cb) {
    if (!handle) { cb(null); return; }
    if (prodCache[handle]) { cb(prodCache[handle]); return; }
    fetch('/products/' + handle + '.js', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (p) {
      prodCache[handle] = p;
      cb(p);
    }).catch(function () { cb(null); });
  }
  function selectedVal(item, sel) {
    var b = item.querySelector(sel + '.active');
    return b ? b.getAttribute('data-value') : null;
  }
  function setLabel(item, sel, val) {
    var el = item.querySelector(sel);
    if (el && val) el.textContent = val;
  }

  // Igual ao produto principal: marca X nos tamanhos sem estoque na cor atual
  // e nas cores sem estoque no tamanho atual.
  function markItem(item, p) {
    var cIdx = parseInt(item.getAttribute('data-color-idx'), 10);
    var sIdx = parseInt(item.getAttribute('data-size-idx'), 10);
    if (isNaN(cIdx)) cIdx = null;
    if (isNaN(sIdx)) sIdx = null;
    var selColor = selectedVal(item, '[data-look-color]');
    var selSize = selectedVal(item, '[data-look-size]');
    if (!p || !p.variants) return;

    item.querySelectorAll('[data-look-size]').forEach(function (btn) {
      var val = btn.getAttribute('data-value');
      var avail = false;
      for (var i = 0; i < p.variants.length; i++) {
        var v = p.variants[i];
        if (v.options[sIdx] !== val) continue;
        if (!v.available) continue;
        if (cIdx !== null && selColor && v.options[cIdx] !== selColor) continue;
        avail = true; break;
      }
      if (avail) { btn.classList.remove('unavailable'); btn.removeAttribute('title'); }
      else { btn.classList.add('unavailable'); btn.setAttribute('title', 'Esgotado nesta cor'); }
    });

    item.querySelectorAll('[data-look-color]').forEach(function (btn) {
      var val = btn.getAttribute('data-value');
      var avail = false;
      for (var i = 0; i < p.variants.length; i++) {
        var v = p.variants[i];
        if (v.options[cIdx] !== val) continue;
        if (!v.available) continue;
        if (sIdx !== null && selSize && v.options[sIdx] !== selSize) continue;
        avail = true; break;
      }
      if (avail) { btn.classList.remove('unavailable'); btn.removeAttribute('disabled'); btn.removeAttribute('title'); }
      else { btn.classList.add('unavailable'); btn.setAttribute('disabled', 'disabled'); btn.setAttribute('title', 'Esgotado neste tamanho'); }
    });

    setLabel(item, '[data-look-selected-size]', selSize);
    setLabel(item, '[data-look-selected-color]', selColor);
    resolveVariant(item, p);
  }

  function resolveVariant(item, p) {
    var cIdx = parseInt(item.getAttribute('data-color-idx'), 10);
    var sIdx = parseInt(item.getAttribute('data-size-idx'), 10);
    if (isNaN(cIdx)) cIdx = null;
    if (isNaN(sIdx)) sIdx = null;
    var selColor = selectedVal(item, '[data-look-color]');
    var selSize = selectedVal(item, '[data-look-size]');
    var variants = p.variants || [];
    var match = null, fallback = null;
    for (var i = 0; i < variants.length; i++) {
      var v = variants[i];
      var okC = (cIdx === null || v.options[cIdx] === selColor);
      var okS = (sIdx === null || v.options[sIdx] === selSize);
      if (okC && okS) {
        if (v.available) { match = v; break; }
        if (!fallback) fallback = v;
      }
    }
    var best = match || fallback;
    var add = item.querySelector('[data-look-add]');
    if (add && best) {
      add.setAttribute('data-look-add', best.id);
      if (best.available) { add.disabled = false; if (!add.classList.contains('added')) add.textContent = 'Adicionar'; }
      else { add.disabled = true; add.textContent = 'Esgotado'; }
    }
  }

  function refreshItem(item) {
    var handle = item.getAttribute('data-handle');
    getProd(handle, function (p) { if (p) markItem(item, p); });
  }

  document.addEventListener('click', function (e) {
    var optBtn = e.target.closest ? e.target.closest('[data-look-color],[data-look-size]') : null;
    if (optBtn) {
      if (optBtn.hasAttribute('disabled')) return;
      var item = optBtn.closest('[data-look-item]');
      var isColor = optBtn.hasAttribute('data-look-color');
      // Cor esgotada (X) não é clicável; tamanho com X continua clicável p/ mostrar Esgotado
      if (isColor && optBtn.classList.contains('unavailable')) return;
      var group = isColor ? item.querySelectorAll('[data-look-color]') : item.querySelectorAll('[data-look-size]');
      group.forEach(function (b) { b.classList.remove('active'); });
      optBtn.classList.add('active');
      refreshItem(item);
      return;
    }
    var addBtn = e.target.closest ? e.target.closest('[data-look-add]') : null;
    if (addBtn && !addBtn.disabled) { addSingle(addBtn); return; }
  });

  // Sincroniza o X ao carregar (busca estoque real por cor/tamanho)
  document.querySelectorAll('[data-look-item]').forEach(function (item) { refreshItem(item); });

  function refreshHeader() {
    if (window.refreshCartBubble) { window.refreshCartBubble(); return; }
    fetch('/cart.js', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (cart) {
      document.querySelectorAll('.header__cart-count').forEach(function (el) {
        el.textContent = cart.item_count;
        el.style.display = cart.item_count > 0 ? '' : 'none';
      });
    }).catch(function () {});
    if (window.NegaRosaCartTimer) window.NegaRosaCartTimer.bump();
  }

  var lookToastTimer = null;
  function showLookToast(msg) {
    if (!msg) return;
    var el = document.getElementById('NrToast');
    if (!el) {
      el = document.createElement('div');
      el.id = 'NrToast';
      el.className = 'nr-toast nr-toast-fallback';
      el.setAttribute('role', 'status');
      document.body.appendChild(el);
    } else if (!el.classList.contains('nr-toast')) {
      el.classList.add('nr-toast-fallback');
    }
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(lookToastTimer);
    lookToastTimer = setTimeout(function () { el.classList.remove('show'); }, 2600);
  }

  // Estoque real vem do Liquid (data-stock), pois o /products/*.js não expõe quantidade.
  function stockMapFor(item) {
    if (item._stockMap) return item._stockMap;
    var map = {};
    try { map = JSON.parse(item.getAttribute('data-stock') || '{}'); } catch (e) { map = {}; }
    item._stockMap = map;
    return map;
  }

  function variantMaxStock(item, variantId) {
    var map = stockMapFor(item);
    var e = map[String(variantId)];
    if (!e) return 999;
    if (e.p === 'continue') return 999;
    if (!e.m) return 999;
    return (typeof e.q === 'number' && e.q > 0) ? e.q : 0;
  }

  function cartQtyFor(variantId, cb) {
    fetch('/cart.js', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (cart) {
      var q = 0;
      if (cart && cart.items) {
        for (var i = 0; i < cart.items.length; i++) {
          if (cart.items[i].variant_id === variantId || cart.items[i].id === variantId) { q = cart.items[i].quantity; break; }
        }
      }
      cb(q);
    }).catch(function () { cb(0); });
  }

  function flyToBag(btn) {
    try {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var item = btn.closest ? btn.closest('[data-look-item]') : null;
      var img = item ? item.querySelector('.look-item__img img') : null;
      var bag = document.querySelector('.header__cart-btn');
      if (!img || !bag) return;
      var r1 = img.getBoundingClientRect();
      var r2 = bag.getBoundingClientRect();
      if (!r1.width || !r2.width) return;
      var ghost = img.cloneNode(false);
      ghost.className = 'nr-fly-img';
      ghost.style.left = r1.left + 'px';
      ghost.style.top = r1.top + 'px';
      ghost.style.width = r1.width + 'px';
      ghost.style.height = r1.height + 'px';
      ghost.style.opacity = '1';
      document.body.appendChild(ghost);
      var dx = (r2.left + r2.width / 2) - (r1.left + r1.width / 2);
      var dy = (r2.top + r2.height / 2) - (r1.top + r1.height / 2);
      // Arco suave: sobe um pouco antes de ir p/ sacola
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          ghost.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(0.12)';
          ghost.style.opacity = '0.4';
          ghost.style.width = '28px';
          ghost.style.height = '28px';
        });
      });
      setTimeout(function () {
        if (ghost.parentNode) ghost.parentNode.removeChild(ghost);
        bag.classList.remove('nr-bump');
        void bag.offsetWidth;
        bag.classList.add('nr-bump');
        setTimeout(function () { bag.classList.remove('nr-bump'); }, 550);
      }, 720);
    } catch (e) { /* sem quebrar o add */ }
  }

  function addSingle(btn) {
    var id = parseInt(btn.getAttribute('data-look-add'), 10);
    if (!id) return;
    var item = btn.closest ? btn.closest('[data-look-item]') : null;
    var orig = btn.textContent;
    btn.disabled = true;
    var max = variantMaxStock(item, id);
    cartQtyFor(id, function (inCart) {
        if (max !== 999 && inCart >= max) {
          showLookToast('Você já atingiu o limite disponível em estoque (' + max + ' un.).');
          btn.disabled = false;
          return;
        }
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
        }).then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); }).then(function (res) {
          btn.disabled = false;
          if (!res.ok || (res.data && res.data.status)) {
            showLookToast((res.data && res.data.description) || 'Não foi possível adicionar. Limite de estoque atingido.');
            return;
          }
          flyToBag(btn);
          btn.classList.add('added');
          btn.textContent = 'Adicionado ✓';
          refreshHeader();
          if (max !== 999 && inCart + 1 >= max) {
            setTimeout(function () {
              btn.classList.remove('added');
              btn.textContent = orig;
              showLookToast('Limite de estoque atingido (' + max + ' un.).');
            }, 1200);
          } else {
            setTimeout(function () { btn.classList.remove('added'); btn.textContent = orig; }, 1500);
          }
        }).catch(function () { btn.disabled = false; showLookToast('Erro de conexão. Tente novamente.'); });
    });
  }

})();
</script>

{%- endif -%}
