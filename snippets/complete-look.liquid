{%- comment -%}
  Snippet: complete-look
  Popup "Monte o Look" a partir do metafield custom.complete_o_look (lista de produtos).
  Reaproveita o shell .size-guide-overlay/.size-guide-modal do main-product.

  Uso (main-product): {% render 'complete-look', product: product %}
  Só renderiza se o metafield estiver preenchido.
{%- endcomment -%}

{%- assign look_products = product.metafields.custom.complete_o_look.value | default: product.metafields.custom.complete_o_look -%}
{%- if look_products != blank and look_products.size > 0 -%}

<button type="button" class="look-open-btn" data-look-open>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
  Monte o look ({{ look_products.size }})
</button>

<div class="size-guide-overlay" data-look-overlay data-look-auto="{{ product.id }}" aria-hidden="true">
  <div class="size-guide-modal" role="dialog" aria-modal="true" aria-label="Monte o look">
    <div class="size-guide-modal__header">
      <h2 class="size-guide-modal__title">Monte o look</h2>
      <button type="button" class="size-guide-modal__close" data-look-close aria-label="Fechar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="20" height="20"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="size-guide-modal__body">
      <div class="look-list">
        {%- for lp in look_products -%}
          {%- if lp.title != blank -%}
            {%- assign lp_size_idx = nil -%}
            {%- for opt in lp.options_with_values -%}
              {%- assign on = opt.name | downcase -%}
              {%- if on contains 'tamanho' or on contains 'size' -%}
                {%- assign lp_size_idx = forloop.index0 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            <div class="look-item" data-look-item>
              <a class="look-item__img" href="{{ lp.url }}" tabindex="-1">
                {%- if lp.featured_image != blank -%}
                  <img src="{{ lp.featured_image | image_url: width: 200 }}" alt="{{ lp.title | escape }}" width="200" height="200" loading="lazy">
                {%- endif -%}
              </a>
              <div class="look-item__info">
                <span class="look-item__title">{{ lp.title }}</span>
                <span class="look-item__price">{{ lp.price | money }}</span>
                {%- if lp_size_idx != nil -%}
                  <div class="look-item__sizes">
                    {%- assign first_set = false -%}
                    {%- for value in lp.options_with_values[lp_size_idx].values -%}
                      {%- assign vv_id = nil -%}
                      {%- for v in lp.variants -%}
                        {%- if v.options[lp_size_idx] == value and v.available -%}
                          {%- assign vv_id = v.id -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if vv_id -%}
                        <button type="button" class="look-size{% unless first_set %} active{% assign first_set = true %}{% endunless %}" data-variant-id="{{ vv_id }}" data-look-size>{{ value }}</button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
              <button type="button" class="look-add" data-look-add="{% if lp.selected_or_first_available_variant %}{{ lp.selected_or_first_available_variant.id }}{% endif %}">Adicionar</button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="button" class="btn btn-primary w-full" data-look-add-all style="margin-top: 12px;">Adicionar look completo</button>
      <p class="look-msg" data-look-msg hidden></p>
    </div>
  </div>
</div>

<style>
  .look-open-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    justify-content: center;
    padding: 12px 16px;
    margin-top: var(--space-3);
    border: 1.5px dashed var(--color-primary, #D81B73);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .look-list { display: flex; flex-direction: column; gap: 10px; }
  .look-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg, #fff);
  }
  .look-item__img { width: 56px; height: 56px; border-radius: 10px; overflow: hidden; flex-shrink: 0; background: var(--color-bg-secondary); }
  .look-item__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .look-item__info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .look-item__title { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .look-item__price { font-size: 13px; font-weight: 600; color: #7F1D1D; }
  .look-item__sizes { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
  .look-size {
    min-width: 24px; height: 24px; padding: 0 6px;
    border-radius: 999px; border: 1px solid var(--color-border);
    background: #fff; font-size: 11px; font-weight: 700; cursor: pointer;
  }
  .look-size.active { border-color: var(--color-primary); background: var(--color-primary); color: #fff; }
  .look-add {
    flex-shrink: 0;
    border: 1px solid var(--color-primary, #D81B73);
    color: var(--color-primary, #D81B73);
    background: transparent;
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
  .look-add.added { background: #16a34a; border-color: #16a34a; color: #fff; }
  .look-msg { font-size: 13px; font-weight: 600; color: #16a34a; text-align: center; margin: 10px 0 0; }
</style>

<script>
(function () {
  if (window.__nrLookBound) return;
  window.__nrLookBound = true;

  function each(sel, fn) { document.querySelectorAll(sel).forEach(fn); }

  function openLook(overlay) {
    overlay.classList.remove('closing');
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeLook(overlay) {
    overlay.classList.add('closing');
    setTimeout(function () {
      overlay.classList.remove('open', 'closing');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }, 160);
  }

  document.addEventListener('click', function (e) {
    var openBtn = e.target.closest ? e.target.closest('[data-look-open]') : null;
    if (openBtn) {
      var ov = openBtn.parentElement.querySelector('[data-look-overlay]') || document.querySelector('[data-look-overlay]');
      if (ov) openLook(ov);
      return;
    }
    var closeBtn = e.target.closest ? e.target.closest('[data-look-close]') : null;
    if (closeBtn) {
      var ov2 = closeBtn.closest('[data-look-overlay]');
      if (ov2) closeLook(ov2);
      return;
    }
    var sizeBtn = e.target.closest ? e.target.closest('[data-look-size]') : null;
    if (sizeBtn) {
      var item = sizeBtn.closest('[data-look-item]');
      item.querySelectorAll('[data-look-size]').forEach(function (b) { b.classList.remove('active'); });
      sizeBtn.classList.add('active');
      var add = item.querySelector('[data-look-add]');
      if (add) add.setAttribute('data-look-add', sizeBtn.getAttribute('data-variant-id'));
      return;
    }
    var addBtn = e.target.closest ? e.target.closest('[data-look-add]') : null;
    if (addBtn && !addBtn.disabled) { addSingle(addBtn); return; }
    var addAll = e.target.closest ? e.target.closest('[data-look-add-all]') : null;
    if (addAll && !addAll.disabled) { addAllLook(addAll); return; }
  });

  document.querySelectorAll('[data-look-overlay]').forEach(function (ov) {
    ov.addEventListener('click', function (e) { if (e.target === ov) closeLook(ov); });
  });

  // Auto-abre 1x por sessão ao entrar no produto (o botão continua disponível)
  function autoOpen() {
    var ov = document.querySelector('[data-look-overlay][data-look-auto]');
    if (!ov || ov.classList.contains('open')) return;
    var pid = ov.getAttribute('data-look-auto');
    var flag = 'nr_look_seen_' + pid;
    try {
      if (sessionStorage.getItem(flag) === '1') return;
      sessionStorage.setItem(flag, '1');
    } catch (e) {}
    openLook(ov);
  }
  window.addEventListener('load', function () { setTimeout(autoOpen, 1500); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-look-overlay].open').forEach(closeLook);
    }
  });

  function refreshHeader() {
    if (window.refreshCartBubble) { window.refreshCartBubble(); return; }
    fetch('/cart.js', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (cart) {
      document.querySelectorAll('.header__cart-count').forEach(function (el) {
        el.textContent = cart.item_count;
        el.style.display = cart.item_count > 0 ? '' : 'none';
      });
    }).catch(function () {});
    if (window.NegaRosaCartTimer) window.NegaRosaCartTimer.bump();
  }

  function addSingle(btn) {
    var id = parseInt(btn.getAttribute('data-look-add'), 10);
    if (!id) return;
    btn.disabled = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
    }).then(function (r) { return r.json(); }).then(function (d) {
      btn.disabled = false;
      if (d && d.status) return;
      btn.classList.add('added');
      var orig = btn.textContent;
      btn.textContent = 'Adicionado ✓';
      refreshHeader();
      setTimeout(function () { btn.classList.remove('added'); btn.textContent = orig; }, 1500);
    }).catch(function () { btn.disabled = false; });
  }

  function addAllLook(btn) {
    var ids = [];
    document.querySelectorAll('[data-look-item] [data-look-add]').forEach(function (b) {
      var id = parseInt(b.getAttribute('data-look-add'), 10);
      if (id && ids.indexOf(id) === -1) ids.push(id);
    });
    if (!ids.length) return;
    btn.disabled = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: ids.map(function (id) { return { id: id, quantity: 1 }; }) })
    }).then(function (r) { return r.json(); }).then(function (d) {
      btn.disabled = false;
      if (d && (d.status || d.description)) return;
      refreshHeader();
      var msg = document.querySelector('[data-look-msg]');
      if (msg) { msg.textContent = 'Look completo na sacola ✓'; msg.hidden = false; }
      setTimeout(function () {
        document.querySelectorAll('[data-look-overlay].open').forEach(closeLook);
      }, 900);
    }).catch(function () { btn.disabled = false; });
  }
})();
</script>

{%- endif -%}
