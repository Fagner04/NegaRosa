{%- comment -%}
  Snippet: complete-look
  Card fixo "Monte o Look" a partir do metafield custom.complete_o_look (lista de produtos).
  Renderiza inline na página, sem popup nem botão.

  Uso (main-product): {% render 'complete-look', product: product %}
  Só renderiza se o metafield estiver preenchido.
{%- endcomment -%}

{%- assign look_products = product.metafields.custom.complete_o_look.value | default: product.metafields.custom.complete_o_look -%}
{%- if look_products != blank and look_products.size > 0 -%}

<div class="look-card" data-look-card>
  <h3 class="look-card__title">Monte o look</h3>
  <div class="look-list">
    {%- for lp in look_products -%}
      {%- if lp.title != blank -%}
        {%- assign lp_color_idx = nil -%}
        {%- assign lp_size_idx = nil -%}
        {%- for opt in lp.options_with_values -%}
          {%- assign on = opt.name | downcase -%}
          {%- if on == 'cor' or on == 'color' or on == 'colour' or on == 'cores' -%}
            {%- assign lp_color_idx = forloop.index0 -%}
          {%- elsif on contains 'tamanho' or on contains 'size' -%}
            {%- assign lp_size_idx = forloop.index0 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign lp_def = lp.selected_or_first_available_variant -%}
        {%- if lp_def == nil -%}
          {%- for v in lp.variants -%}{%- if v.available -%}{%- assign lp_def = v -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- endif -%}
        {%- if lp_def == nil -%}{%- assign lp_def = lp.variants.first -%}{%- endif -%}
        <div class="look-item" data-look-item data-handle="{{ lp.handle }}" data-color-idx="{{ lp_color_idx }}" data-size-idx="{{ lp_size_idx }}">
          <a class="look-item__img" href="{{ lp.url }}">
            {%- if lp.featured_image != blank -%}
              <img src="{{ lp.featured_image | image_url: width: 200 }}" alt="{{ lp.title | escape }}" width="200" height="200" loading="lazy">
            {%- endif -%}
          </a>
          <div class="look-item__info">
            <span class="look-item__title">{{ lp.title }}</span>
            <span class="look-item__price">{{ lp.price | money }}</span>
            {%- if lp_color_idx != nil -%}
              <div class="look-item__sizes" data-look-colors>
                {%- for value in lp.options_with_values[lp_color_idx].values -%}
                  {%- assign has_av = false -%}
                  {%- for v in lp.variants -%}
                    {%- if v.options[lp_color_idx] == value and v.available -%}{%- assign has_av = true -%}{%- break -%}{%- endif -%}
                  {%- endfor -%}
                  {%- if has_av -%}
                    <button type="button" class="look-size{% if lp_def.options[lp_color_idx] == value %} active{% endif %}" data-look-color data-value="{{ value | escape }}">{{ value }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if lp_size_idx != nil -%}
              <div class="look-item__sizes">
                {%- for value in lp.options_with_values[lp_size_idx].values -%}
                  {%- assign has_av = false -%}
                  {%- for v in lp.variants -%}
                    {%- if v.options[lp_size_idx] == value and v.available -%}{%- assign has_av = true -%}{%- break -%}{%- endif -%}
                  {%- endfor -%}
                  {%- if has_av -%}
                    <button type="button" class="look-size{% if lp_def.options[lp_size_idx] == value %} active{% endif %}" data-look-size data-value="{{ value | escape }}">{{ value }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          <button type="button" class="look-add" data-look-add="{{ lp_def.id }}">Adicionar</button>
        </div>
      {%- endif -%}
    {%- endfor -%}
</div>

<style>
  .look-card {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border: none;
    border-radius: 16px;
    background: var(--color-bg, #fff);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10), 0 2px 6px rgba(0, 0, 0, 0.06);
  }
  .look-card__title {
    font-size: var(--font-size-base);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-3);
  }
  .look-list { display: flex; flex-direction: column; gap: 10px; }
  .look-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border: none;
    border-radius: 12px;
    background: var(--color-bg, #fff);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.05);
  }
  .look-item__img { width: 56px; height: 56px; border-radius: 10px; overflow: hidden; flex-shrink: 0; background: var(--color-bg-secondary); }
  .look-item__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .look-item__info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .look-item__title { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .look-item__price { font-size: 13px; font-weight: 600; color: #7F1D1D; }
  .look-item__sizes { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
  .look-size {
    min-width: 24px; height: 24px; padding: 0 6px;
    border-radius: 999px; border: 1px solid var(--color-border);
    background: #fff; font-size: 11px; font-weight: 700; cursor: pointer;
  }
  .look-size.active { border-color: var(--color-primary); background: var(--color-primary); color: #fff; }
  .look-add {
    flex-shrink: 0;
    border: 1px solid var(--color-primary, #D81B73);
    color: var(--color-primary, #D81B73);
    background: transparent;
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
  .look-add.added { background: #16a34a; border-color: #16a34a; color: #fff; }
  @media (max-width: 480px) {
    .look-card { padding: var(--space-3); }
    .look-item { flex-wrap: wrap; }
    .look-item__info { flex: 1 1 calc(100% - 66px); }
    .look-add { flex: 1 1 100%; padding: 10px; }
  }
</style>

<script>
(function () {
  if (window.__nrLookBound) return;
  window.__nrLookBound = true;

  var prodCache = {};
  function getProd(handle, cb) {
    if (!handle) { cb(null); return; }
    if (prodCache[handle]) { cb(prodCache[handle]); return; }
    fetch('/products/' + handle + '.js', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (p) {
      prodCache[handle] = p;
      cb(p);
    }).catch(function () { cb(null); });
  }
  function selectedVal(item, sel) {
    var b = item.querySelector(sel + '.active');
    return b ? b.getAttribute('data-value') : null;
  }
  function resolveItem(item) {
    var handle = item.getAttribute('data-handle');
    var cIdx = parseInt(item.getAttribute('data-color-idx'), 10);
    var sIdx = parseInt(item.getAttribute('data-size-idx'), 10);
    if (isNaN(cIdx)) cIdx = null;
    if (isNaN(sIdx)) sIdx = null;
    var selColor = selectedVal(item, '[data-look-color]');
    var selSize = selectedVal(item, '[data-look-size]');
    if (cIdx === null && sIdx === null) return;
    getProd(handle, function (p) {
      if (!p || !p.variants) return;
      var match = null, fallback = null;
      for (var i = 0; i < p.variants.length; i++) {
        var v = p.variants[i];
        var okC = (cIdx === null || v.options[cIdx] === selColor);
        var okS = (sIdx === null || v.options[sIdx] === selSize);
        if (okC && okS) {
          if (v.available) { match = v; break; }
          if (!fallback) fallback = v;
        }
      }
      var best = match || fallback;
      if (best) {
        var add = item.querySelector('[data-look-add]');
        if (add) add.setAttribute('data-look-add', best.id);
      }
    });
  }
  document.addEventListener('click', function (e) {
    var optBtn = e.target.closest ? e.target.closest('[data-look-color],[data-look-size]') : null;
    if (optBtn) {
      var item = optBtn.closest('[data-look-item]');
      var group = optBtn.hasAttribute('data-look-color') ? item.querySelectorAll('[data-look-color]') : item.querySelectorAll('[data-look-size]');
      group.forEach(function (b) { b.classList.remove('active'); });
      optBtn.classList.add('active');
      resolveItem(item);
      return;
    }
    var addBtn = e.target.closest ? e.target.closest('[data-look-add]') : null;
    if (addBtn && !addBtn.disabled) { addSingle(addBtn); return; }
  });

  function refreshHeader() {
    if (window.refreshCartBubble) { window.refreshCartBubble(); return; }
    fetch('/cart.js', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (cart) {
      document.querySelectorAll('.header__cart-count').forEach(function (el) {
        el.textContent = cart.item_count;
        el.style.display = cart.item_count > 0 ? '' : 'none';
      });
    }).catch(function () {});
    if (window.NegaRosaCartTimer) window.NegaRosaCartTimer.bump();
  }

  function addSingle(btn) {
    var id = parseInt(btn.getAttribute('data-look-add'), 10);
    if (!id) return;
    btn.disabled = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
    }).then(function (r) { return r.json(); }).then(function (d) {
      btn.disabled = false;
      if (d && d.status) return;
      btn.classList.add('added');
      var orig = btn.textContent;
      btn.textContent = 'Adicionado ✓';
      refreshHeader();
      setTimeout(function () { btn.classList.remove('added'); btn.textContent = orig; }, 1500);
    }).catch(function () { btn.disabled = false; });
  }

})();
</script>

{%- endif -%}
