{%- comment -%}
  Section: Coupon Widget
  Botão flutuante lateral "CUPOM" que abre um card ticket com animações CSS.
{%- endcomment -%}

{%- if settings.coupon_enabled and settings.coupon_code != blank -%}

<style>
  /* ── Keyframes ─────────────────────────────────────────── */

  @keyframes coupon-slide-in {
    from { transform: translateX(100%); opacity: 0; }
    to   { transform: translateX(0);    opacity: 1; }
  }

  @keyframes coupon-slide-out {
    from { transform: translateX(0);    opacity: 1; }
    to   { transform: translateX(110%); opacity: 0; }
  }

  @keyframes coupon-card-in {
    from { transform: translateX(110%) scaleY(0.92); opacity: 0; }
    to   { transform: translateX(0)    scaleY(1);    opacity: 1; }
  }

  @keyframes coupon-card-out {
    from { transform: translateX(0)    scaleY(1);    opacity: 1; }
    to   { transform: translateX(110%) scaleY(0.92); opacity: 0; }
  }

  @keyframes coupon-shimmer {
    0%   { background-position: -200% center; }
    100% { background-position: 200%  center; }
  }

  @keyframes coupon-pulse-tab {
    0%, 100% { box-shadow: -4px 0 18px rgba(0,0,0,0.25); }
    50%       { box-shadow: -4px 0 28px rgba(0,0,0,0.45); }
  }

  @keyframes coupon-bounce-tab {
    0%, 100% { transform: translateY(0); }
    40%      { transform: translateY(-6px); }
    70%      { transform: translateY(-2px); }
  }

  @keyframes coupon-copy-pop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.18); }
    70%  { transform: scale(0.95); }
    100% { transform: scale(1); }
  }

  @keyframes coupon-tick-in {
    from { transform: scale(0) rotate(-45deg); opacity: 0; }
    to   { transform: scale(1) rotate(0deg);   opacity: 1; }
  }

  /* ── Tab (botão lateral) ───────────────────────────────── */

  .coupon-tab {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 9000;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    background: {{ settings.tab_bg_color }};
    color: {{ settings.tab_text_color }};
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 20px 10px;
    border-radius: 10px 0 0 10px;
    cursor: pointer;
    border: none;
    user-select: none;
    animation: coupon-slide-in 0.5s cubic-bezier(0.22,1,0.36,1) both,
               coupon-pulse-tab 3s ease-in-out 1.5s infinite;
    transition: background 0.2s, transform 0.2s;
    line-height: 1;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .coupon-tab:hover {
    background: {{ settings.tab_bg_color | color_darken: 12 }};
    animation: coupon-bounce-tab 0.5s ease both,
               coupon-pulse-tab 3s ease-in-out 0.5s infinite;
  }

  .coupon-tab__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transform: rotate(90deg);
  }

  .coupon-tab.hidden {
    animation: coupon-slide-out 0.35s cubic-bezier(0.55,0,1,0.45) both;
  }

  /* ── Card (ticket) ─────────────────────────────────────── */

  .coupon-card {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%) translateX(110%);
    z-index: 9001;
    display: flex;
    width: min(340px, 92vw);
    border-radius: 12px 0 0 12px;
    overflow: hidden;
    box-shadow: -6px 0 40px rgba(0,0,0,0.22);
    pointer-events: none;
    opacity: 0;
  }

  .coupon-card.open {
    animation: coupon-card-in 0.42s cubic-bezier(0.22,1,0.36,1) both;
    pointer-events: auto;
    opacity: 1;
  }

  .coupon-card.closing {
    animation: coupon-card-out 0.32s cubic-bezier(0.55,0,1,0.45) both;
    pointer-events: none;
  }

  /* Tira lateral escura — "CUPOM" vertical */
  .coupon-card__strip {
    width: 52px;
    flex-shrink: 0;
    background: {{ settings.tab_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    color: {{ settings.tab_text_color }};
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    gap: 8px;
    user-select: none;
  }

  .coupon-card__strip-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transform: rotate(90deg);
  }

  /* Corpo branco do ticket */
  .coupon-card__body {
    flex: 1;
    background: {{ settings.card_bg_color }};
    padding: 24px 20px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    position: relative;
  }

  /* Semicírculos do ticket */
  .coupon-card__body::before,
  .coupon-card__body::after {
    content: '';
    position: absolute;
    left: -10px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: {{ settings.tab_bg_color }};
  }
  .coupon-card__body::before { top:  -10px; }
  .coupon-card__body::after  { bottom: -10px; }

  .coupon-card__close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    cursor: pointer;
    color: {{ settings.card_text_color | color_modify: 'alpha', 0.5 }};
    padding: 4px;
    border-radius: 50%;
    transition: color 0.2s, background 0.2s;
    line-height: 0;
  }

  .coupon-card__close:hover {
    color: {{ settings.card_text_color }};
    background: rgba(0,0,0,0.06);
  }

  .coupon-card__discount {
    font-size: 15px;
    font-weight: 600;
    color: {{ settings.accent_color }};
    letter-spacing: 0.02em;
    margin-top: 8px;
  }

  .coupon-card__headline {
    font-size: 22px;
    font-weight: 900;
    color: {{ settings.card_text_color }};
    text-align: center;
    line-height: 1.2;
    margin: 2px 0 6px;
  }

  .coupon-card__sublabel {
    font-size: 13px;
    font-weight: 500;
    color: {{ settings.accent_color }};
    letter-spacing: 0.01em;
  }

  /* Código copiável */
  .coupon-card__code-wrap {
    margin-top: 10px;
    width: 100%;
    display: flex;
    align-items: center;
    border: 2px dashed {{ settings.card_text_color | color_modify: 'alpha', 0.25 }};
    border-radius: 8px;
    overflow: hidden;
    background: {{ settings.card_bg_color | color_darken: 3 }};
    transition: border-color 0.2s;
  }

  .coupon-card__code-wrap:hover {
    border-color: {{ settings.accent_color }};
  }

  .coupon-card__code {
    flex: 1;
    padding: 11px 14px;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: {{ settings.card_text_color }};
    text-align: center;
    background: transparent;

    /* Shimmer animado no código */
    background: linear-gradient(
      90deg,
      {{ settings.card_text_color }} 0%,
      {{ settings.card_text_color }} 35%,
      {{ settings.accent_color }} 50%,
      {{ settings.card_text_color }} 65%,
      {{ settings.card_text_color }} 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: coupon-shimmer 3s linear infinite;
  }

  .coupon-card__copy-btn {
    padding: 0 14px;
    height: 100%;
    min-height: 46px;
    background: {{ settings.tab_bg_color }};
    color: {{ settings.tab_text_color }};
    border: none;
    cursor: pointer;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: background 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    line-height: 1;
  }

  .coupon-card__copy-btn:hover {
    background: {{ settings.tab_bg_color | color_darken: 12 }};
  }

  .coupon-card__copy-btn.copied {
    animation: coupon-copy-pop 0.4s ease both;
    background: #22c55e;
  }

  .coupon-card__copy-icon { line-height: 0; }
  .coupon-card__copy-label { font-size: 10px; }

  .coupon-card__tick {
    display: none;
  }

  .coupon-card__copy-btn.copied .coupon-card__copy-icon { display: none; }
  .coupon-card__copy-btn.copied .coupon-card__tick {
    display: block;
    animation: coupon-tick-in 0.3s ease both;
  }
  .coupon-card__copy-btn.copied .coupon-card__copy-label::before { content: 'Copiado'; }
  .coupon-card__copy-btn:not(.copied) .coupon-card__copy-label::before { content: 'Copiar'; }

  /* Validade */
  .coupon-card__validity {
    font-size: 11px;
    color: {{ settings.card_text_color | color_modify: 'alpha', 0.45 }};
    margin-top: 8px;
    text-align: center;
  }

  /* ── Responsivo ────────────────────────────────────────── */
  @media (max-width: 480px) {
    .coupon-tab {
      font-size: 11px;
      padding: 16px 8px;
    }
    .coupon-card {
      width: 88vw;
    }
  }
</style>

<!-- Tab (botão lateral) -->
<button class="coupon-tab" id="CouponTab" aria-label="Ver cupom de desconto" aria-expanded="false">
  <svg class="coupon-tab__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
       stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
    <line x1="7" y1="7" x2="7.01" y2="7"/>
  </svg>
  CUPOM
</button>

<!-- Card (ticket) -->
<div class="coupon-card" id="CouponCard" role="dialog" aria-label="Cupom de desconto" aria-modal="true">

  <!-- Tira lateral -->
  <div class="coupon-card__strip" aria-hidden="true">
    <svg class="coupon-card__strip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
      <line x1="7" y1="7" x2="7.01" y2="7"/>
    </svg>
    CUPOM
  </div>

  <!-- Corpo -->
  <div class="coupon-card__body">

    <button class="coupon-card__close" id="CouponClose" aria-label="Fechar cupom">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" width="16" height="16">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <p class="coupon-card__discount">{{ settings.coupon_discount_label }}</p>

    <h2 class="coupon-card__headline">{{ settings.coupon_headline }}</h2>

    <p class="coupon-card__sublabel">Copie o Cupom</p>

    <div class="coupon-card__code-wrap">
      <span class="coupon-card__code" aria-label="Código do cupom: {{ settings.coupon_code }}">
        {{ settings.coupon_code }}
      </span>
      <button class="coupon-card__copy-btn" id="CouponCopyBtn"
              data-code="{{ settings.coupon_code | escape }}"
              aria-label="Copiar código {{ settings.coupon_code }}">
        <span class="coupon-card__copy-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" width="16" height="16">
            <rect x="9" y="9" width="13" height="13" rx="2"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
        </span>
        <span class="coupon-card__tick">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"
               stroke-linecap="round" width="16" height="16">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </span>
        <span class="coupon-card__copy-label"></span>
      </button>
    </div>

    {%- if settings.coupon_validity != blank -%}
      <p class="coupon-card__validity">{{ settings.coupon_validity }}</p>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var tab      = document.getElementById('CouponTab');
    var card     = document.getElementById('CouponCard');
    var closeBtn = document.getElementById('CouponClose');
    var copyBtn  = document.getElementById('CouponCopyBtn');
    var isOpen   = false;

    function openCard() {
      isOpen = true;
      tab.classList.add('hidden');
      tab.setAttribute('aria-expanded', 'true');
      card.classList.remove('closing');
      card.classList.add('open');
    }

    function closeCard() {
      isOpen = false;
      card.classList.add('closing');
      card.addEventListener('animationend', function onEnd() {
        card.classList.remove('open', 'closing');
        tab.classList.remove('hidden');
        tab.setAttribute('aria-expanded', 'false');
        card.removeEventListener('animationend', onEnd);
      });
    }

    tab.addEventListener('click', openCard);
    closeBtn.addEventListener('click', closeCard);

    // Fechar ao clicar fora
    document.addEventListener('click', function (e) {
      if (isOpen && !card.contains(e.target) && e.target !== tab) {
        closeCard();
      }
    });

    // Fechar com Escape
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) closeCard();
    });

    // Copiar código
    copyBtn.addEventListener('click', function () {
      var code = copyBtn.getAttribute('data-code');
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code);
      } else {
        var ta = document.createElement('textarea');
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      copyBtn.classList.add('copied');
      setTimeout(function () { copyBtn.classList.remove('copied'); }, 2500);
    });
  })();
</script>

{%- endif -%}

