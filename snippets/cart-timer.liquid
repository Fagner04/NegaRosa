{%- comment -%}
  Snippet: cart-timer
  Temporizador de reserva do carrinho (config em Configurações > Carrinho).
  - Motor (sempre): sincroniza o prazo via /cart.js e limpa com /cart/clear.js ao expirar.
  - Banner (banner: true): countdown visível. Use na página do carrinho.

  Uso:
    {% render 'cart-timer' %}                (motor, ex: layout)
    {% render 'cart-timer', banner: true %}  (motor + banner, ex: main-cart)
{%- endcomment -%}

{%- if settings.cart_timer_enabled -%}

<a class="cart-balloon" data-cart-balloon href="{{ routes.cart_url }}" hidden aria-label="Ver sacola">
  <span class="cart-balloon__icon">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 01-8 0"></path></svg>
    <span class="cart-balloon__qty" data-cart-balloon-qty>0</span>
  </span>
  <span class="cart-balloon__time" data-cart-balloon-time>--:--</span>
</a>
<style>
  .cart-balloon {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 900;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #111;
    color: #fff;
    border-radius: 999px;
    padding: 10px 16px 10px 12px;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    font-size: 13px;
    font-weight: 700;
  }
  .cart-balloon[hidden] { display: none; }
  .cart-balloon__icon { position: relative; display: inline-flex; }
  .cart-balloon__qty {
    position: absolute;
    top: -8px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 999px;
    background: #D81B73;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .cart-balloon__time { font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  @media (max-width: 640px) {
    .cart-balloon { left: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); }
  }
</style>

{%- if banner -%}
<div class="cart-timer" data-cart-timer hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
  <span>{{ settings.cart_timer_text | default: 'Seu carrinho fica reservado por' }} <strong data-cart-timer-count>--:--</strong></span>
</div>
<div class="cart-timer cart-timer--expired" data-cart-timer-expired hidden>
  <span>{{ settings.cart_timer_expired_text | default: 'Seu tempo esgotou — o carrinho foi esvaziado.' }}</span>
</div>
<style>
  .cart-timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: var(--space-4);
    padding: 4px 0;
    background: transparent;
    border: none;
    color: inherit;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
  }
  .cart-timer strong { font-variant-numeric: tabular-nums; }
  .cart-timer[hidden] { display: none; }
  .cart-timer--expired {
    background: transparent;
    border: none;
    color: inherit;
  }
</style>
{%- endif -%}

<script>
(function () {
  if (window.__nrCartTimer) return;
  window.__nrCartTimer = true;

  var MINUTES = {{ settings.cart_timer_minutes | default: 30 | json }};
  var KEY = 'nr_cart_deadline';
  var COUNT_KEY = 'nr_cart_count';
  var EXPIRED_FLAG = 'nr_cart_expired';

  function store(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function read(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function del(k) { try { localStorage.removeItem(k); } catch (e) {} }

  function fmt(ms) {
    var s = Math.max(0, Math.ceil(ms / 1000));
    var m = Math.floor(s / 60);
    var r = s % 60;
    return (m < 10 ? '0' + m : '' + m) + ':' + (r < 10 ? '0' + r : '' + r);
  }

  function paint() {
    var deadline = parseInt(read(KEY), 10) || 0;
    if (!deadline) return;
    var left = fmt(deadline - Date.now());
    var banner = document.querySelector('[data-cart-timer]');
    if (banner && !banner.hidden) {
      var countEl = banner.querySelector('[data-cart-timer-count]');
      if (countEl) countEl.textContent = left;
    }
    var balloon = document.querySelector('[data-cart-balloon]');
    if (balloon && !balloon.hidden) {
      var timeEl = balloon.querySelector('[data-cart-balloon-time]');
      if (timeEl) timeEl.textContent = left;
    }
  }

  var timer = null;
  function stopTick() { if (timer) { clearInterval(timer); timer = null; } }

  function tick() {
    var deadline = parseInt(read(KEY), 10) || 0;
    if (!deadline) { sync(); return; }
    if (deadline - Date.now() <= 0) { expire(); return; }
    paint();
  }

  function startTick() {
    stopTick();
    tick();
    timer = setInterval(tick, 1000);
  }

  function clearStored() { del(KEY); del(COUNT_KEY); }

  var expiring = false;
  function expire() {
    if (expiring) return;
    expiring = true;
    stopTick();
    fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
      .then(function () {
        try { sessionStorage.setItem(EXPIRED_FLAG, '1'); } catch (e) {}
        clearStored();
        if (window.location.pathname.indexOf('/cart') === 0) {
          window.location.reload();
        } else {
          document.querySelectorAll('.header__cart-count').forEach(function (el) {
            el.textContent = '0';
            el.style.display = 'none';
          });
          document.dispatchEvent(new CustomEvent('cart:cleared-expired'));
          expiring = false;
        }
      })
      .catch(function () { expiring = false; });
  }

  function sync() {
    fetch('/cart.js', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var banner = document.querySelector('[data-cart-timer]');
        var expiredBanner = document.querySelector('[data-cart-timer-expired]');
        var balloon = document.querySelector('[data-cart-balloon]');
        if (!cart || cart.item_count <= 0) {
          clearStored();
          stopTick();
          var wasExpired = false;
          try {
            wasExpired = sessionStorage.getItem(EXPIRED_FLAG) === '1';
            sessionStorage.removeItem(EXPIRED_FLAG);
          } catch (e) {}
          if (banner) banner.hidden = true;
          if (balloon) balloon.hidden = true;
          if (wasExpired && expiredBanner) expiredBanner.hidden = false;
          return;
        }
        if (expiredBanner) expiredBanner.hidden = true;
        var lastCount = read(COUNT_KEY);
        var deadline = parseInt(read(KEY), 10) || 0;
        if (String(cart.item_count) !== String(lastCount) || !deadline || deadline <= Date.now()) {
          deadline = Date.now() + MINUTES * 60000;
          store(KEY, String(deadline));
          store(COUNT_KEY, String(cart.item_count));
        }
        if (banner) banner.hidden = false;
        if (balloon) {
          var qtyEl = balloon.querySelector('[data-cart-balloon-qty]');
          if (qtyEl) qtyEl.textContent = cart.item_count > 99 ? '99+' : String(cart.item_count);
          balloon.hidden = false;
        }
        startTick();
      })
      .catch(function () {});
  }

  window.NegaRosaCartTimer = {
    sync: sync,
    bump: function () { del(KEY); sync(); }
  };

  document.addEventListener('visibilitychange', function () { if (!document.hidden) sync(); });
  window.addEventListener('storage', function (e) {
    if (e.key === KEY || e.key === COUNT_KEY) sync();
  });
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', sync);
  } else {
    sync();
  }
})();
</script>

{%- endif -%}
