{%- comment -%}
  Social Proof Notifications - iPhone style sliding from left
  Powered by anime.js v4
{%- endcomment -%}

{%- if settings.social_proof_enabled -%}
{%- assign sp_products = collections[settings.social_proof_collection].products | default: collections.all.products -%}

<div class="social-proof-container" id="social-proof-container" aria-live="polite" aria-atomic="true"></div>

<script id="social-proof-data" type="application/json">
{
  "names": {{ settings.social_proof_names | default: "Maria,João,Ana,Pedro,Juliana,Carlos,Beatriz,Lucas,Fernanda,Rafael,Camila,Bruno,Larissa,Thiago,Patricia,Gustavo,Amanda,Felipe,Mariana,Rodrigo" | split: "," | json }},
  "cities": {{ settings.social_proof_cities | default: "São Paulo - SP,Rio de Janeiro - RJ,Belo Horizonte - MG,Curitiba - PR,Porto Alegre - RS,Salvador - BA,Fortaleza - CE,Brasília - DF,Recife - PE,Goiânia - GO" | split: "," | json }},
  "products": [
    {%- for product in sp_products limit: 20 -%}
      {
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "image": {{ product.featured_image | image_url: width: 200 | prepend: 'https:' | json }},
        "price": {{ product.price | money | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "interval": {{ settings.social_proof_interval | default: 12 }},
  "duration": {{ settings.social_proof_duration | default: 6 }},
  "initialDelay": {{ settings.social_proof_initial_delay | default: 5 }},
  "verb": {{ settings.social_proof_verb | default: "acabou de comprar" | json }}
}
</script>

<style>
  .social-proof-container{position:fixed;left:20px;bottom:24px;z-index:9997;pointer-events:none;display:flex;flex-direction:column;gap:10px;max-width:340px;width:calc(100vw - 40px)}
  .sp-toast{pointer-events:auto;display:flex;align-items:center;gap:12px;padding:10px 14px 10px 10px;background:rgba(255,255,255,.45);backdrop-filter:saturate(180%) blur(24px);-webkit-backdrop-filter:saturate(180%) blur(24px);border:1px solid rgba(255,255,255,.5);border-radius:18px;box-shadow:0 10px 30px -8px rgba(0,0,0,.15),0 2px 6px rgba(0,0,0,.05);text-decoration:none;color:#111;opacity:0;transform:translateX(-120%);will-change:transform,opacity;position:relative;overflow:hidden}
  .sp-toast__img{flex:0 0 46px;width:46px;height:46px;border-radius:12px;object-fit:cover;background:#f2f2f2}
  .sp-toast__body{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:2px;line-height:1.25}
  .sp-toast__head{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .sp-toast__app{font-size:11px;font-weight:600;letter-spacing:.02em;color:#6b6b70;text-transform:uppercase;display:flex;align-items:center;gap:5px}
  .sp-toast__app::before{content:"";width:8px;height:8px;border-radius:50%;background:#22c55e;display:inline-block;flex-shrink:0}
  .sp-toast__time{font-size:11px;color:#8a8a90;flex-shrink:0}
  .sp-toast__title{font-size:13px;font-weight:600;color:#111;margin:0;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;word-break:break-word}
  .sp-toast__desc{font-size:12px;color:#3a3a3c;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
  .sp-toast__close{position:absolute;top:6px;right:6px;width:18px;height:18px;border-radius:50%;border:0;background:rgba(0,0,0,.08);color:#333;font-size:12px;line-height:1;display:none;align-items:center;justify-content:center;cursor:pointer;padding:0}
  .sp-toast:hover .sp-toast__close{display:flex}
  /* Força fundo branco translúcido também em produção/dark mode do SO */
  @media (max-width:749px){
    .social-proof-container{left:12px;bottom:90px;max-width:300px;width:calc(100vw - 24px)}
    .sp-toast{padding:8px 12px 8px 8px;border-radius:16px}
    .sp-toast__img{width:42px;height:42px;border-radius:10px;flex-basis:42px}
    .sp-toast__title{font-size:12px}.sp-toast__desc{font-size:11px}
  }
  @media (prefers-reduced-motion:reduce){.sp-toast{transition:opacity .2s ease}}
</style>

<script type="module">
  import { animate } from 'https://esm.sh/animejs@4';

  (function(){
    const dataEl = document.getElementById('social-proof-data');
    const container = document.getElementById('social-proof-container');
    if(!dataEl || !container) return;
    let cfg;
    try { cfg = JSON.parse(dataEl.textContent); } catch(e){ return; }
    if(!cfg.products || !cfg.products.length) return;

    const rand = (arr) => arr[Math.floor(Math.random()*arr.length)];
    const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function buildToast(){
      const name = rand(cfg.names).trim();
      const city = rand(cfg.cities).trim();
      const product = rand(cfg.products);
      const minutes = Math.floor(Math.random()*55)+2;
      const a = document.createElement('a');
      a.className = 'sp-toast';
      a.href = product.url || '#';
      a.setAttribute('role','status');
      a.innerHTML = `
        <img class="sp-toast__img" src="${escapeHtml(product.image||'')}" alt="" loading="lazy" width="46" height="46">
        <div class="sp-toast__body">
          <div class="sp-toast__head">
            <span class="sp-toast__app">Compra confirmada</span>
            <span class="sp-toast__time">há ${minutes} min</span>
          </div>
          <p class="sp-toast__title">${escapeHtml(name)} de ${escapeHtml(city)}</p>
          <p class="sp-toast__desc">${escapeHtml(cfg.verb)} <strong>${escapeHtml(product.title)}</strong></p>
        </div>
        <button class="sp-toast__close" type="button" aria-label="Fechar">×</button>
      `;
      return a;
    }

    function showToast(){
      if(document.hidden) return;
      const t = buildToast();
      container.appendChild(t);

      const enter = () => animate(t, {
        translateX: ['-120%','0%'],
        opacity: [0,1],
        duration: 650,
        ease: 'out(3)'
      });
      const leave = () => animate(t, {
        translateX: ['0%','-120%'],
        opacity: [1,0],
        duration: 500,
        ease: 'in(2)',
        onComplete: () => t.remove()
      });

      if(reduced){ t.style.transform='translateX(0)'; t.style.opacity='1'; }
      else { enter(); }

      const timeout = setTimeout(leave, cfg.duration*1000);
      t.querySelector('.sp-toast__close').addEventListener('click', (e)=>{
        e.preventDefault(); e.stopPropagation(); clearTimeout(timeout); leave();
      });
    }

    setTimeout(function loop(){
      showToast();
      setInterval(showToast, Math.max(4, cfg.interval)*1000);
    }, Math.max(1, cfg.initialDelay)*1000);
  })();
</script>
{%- endif -%}
