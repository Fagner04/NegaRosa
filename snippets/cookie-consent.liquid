{%- comment -%}
  Snippet: Cookie Consent Bar
  Barra profissional de aceite de cookies (LGPD).
{%- endcomment -%}

<div id="cookie-consent" class="cookie-consent" role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
  <div class="cookie-consent__inner">
    <div class="cookie-consent__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Z"/>
        <circle cx="9" cy="10" r="1"/>
        <circle cx="14" cy="14" r="1"/>
        <circle cx="16" cy="8" r="1"/>
        <circle cx="8" cy="16" r="1"/>
      </svg>
    </div>
    <div class="cookie-consent__content">
      <strong class="cookie-consent__title">Sua privacidade é importante</strong>
      <p class="cookie-consent__text">
        Utilizamos cookies para melhorar sua experiência de navegação, personalizar conteúdo e analisar nosso tráfego.
        Ao clicar em <em>“Aceitar”</em>, você concorda com o uso de cookies conforme nossa
        <a href="/policies/privacy-policy">Política de Privacidade</a>.
      </p>
    </div>
    <div class="cookie-consent__actions">
      <button type="button" class="cookie-consent__btn cookie-consent__btn--ghost" data-cookie-action="reject">Recusar</button>
      <button type="button" class="cookie-consent__btn cookie-consent__btn--primary" data-cookie-action="accept">Aceitar</button>
    </div>
    <button type="button" class="cookie-consent__close" data-cookie-action="reject" aria-label="Fechar aviso">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
</div>

<style>
  .cookie-consent{position:fixed;left:16px;right:16px;bottom:16px;z-index:99999;background:rgba(255,255,255,.92);color:#111;border:1px solid rgba(0,0,0,.08);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.18);backdrop-filter:saturate(180%) blur(14px);-webkit-backdrop-filter:saturate(180%) blur(14px);transform:translateY(24px);opacity:0;transition:opacity .35s ease,transform .35s ease;pointer-events:none;max-width:1100px;margin:0 auto;}
  .cookie-consent.is-open{opacity:1;transform:translateY(0);pointer-events:auto;}
  .cookie-consent[hidden]{display:none;}
  .cookie-consent__inner{display:flex;align-items:center;gap:18px;padding:16px 20px;position:relative;}
  .cookie-consent__icon{flex:0 0 auto;width:40px;height:40px;border-radius:50%;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;}
  .cookie-consent__icon svg{width:22px;height:22px;}
  .cookie-consent__content{flex:1;min-width:0;}
  .cookie-consent__title{display:block;font-size:14px;font-weight:700;letter-spacing:.3px;margin-bottom:2px;}
  .cookie-consent__text{margin:0;font-size:12.5px;line-height:1.5;color:#4a4a4a;}
  .cookie-consent__text a{color:#111;text-decoration:underline;text-underline-offset:2px;font-weight:600;}
  .cookie-consent__actions{display:flex;gap:8px;flex:0 0 auto;}
  .cookie-consent__btn{appearance:none;border:0;border-radius:999px;padding:10px 18px;font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;cursor:pointer;transition:transform .15s ease,background .2s ease,color .2s ease,border-color .2s ease;}
  .cookie-consent__btn:hover{transform:translateY(-1px);}
  .cookie-consent__btn:focus-visible{outline:2px solid #111;outline-offset:2px;}
  .cookie-consent__btn--primary{background:#111;color:#fff;}
  .cookie-consent__btn--primary:hover{background:#000;}
  .cookie-consent__btn--ghost{background:transparent;color:#111;border:1px solid rgba(0,0,0,.15);}
  .cookie-consent__btn--ghost:hover{border-color:#111;}
  .cookie-consent__close{position:absolute;top:8px;right:8px;background:transparent;border:0;color:#666;cursor:pointer;padding:6px;border-radius:50%;display:none;}
  .cookie-consent__close:hover{color:#111;background:rgba(0,0,0,.05);}
  @media (max-width:749px){
    .cookie-consent{left:10px;right:10px;bottom:10px;border-radius:14px;}
    .cookie-consent__inner{flex-direction:column;align-items:flex-start;gap:12px;padding:16px;padding-right:36px;}
    .cookie-consent__icon{width:34px;height:34px;}
    .cookie-consent__icon svg{width:18px;height:18px;}
    .cookie-consent__text{font-size:12px;}
    .cookie-consent__actions{width:100%;}
    .cookie-consent__btn{flex:1;padding:11px 12px;}
    .cookie-consent__close{display:inline-flex;}
  }
  @media (prefers-reduced-motion:reduce){
    .cookie-consent{transition:none;}
  }
</style>

<script>
  (function(){
    var KEY='cw_cookie_consent_v1';
    var el=document.getElementById('cookie-consent');
    if(!el)return;
    var stored;
    try{stored=localStorage.getItem(KEY);}catch(e){stored=null;}
    if(stored==='accepted'||stored==='rejected')return;

    el.hidden=false;
    // small delay for smooth entrance
    setTimeout(function(){el.classList.add('is-open');},400);

    function close(value){
      try{localStorage.setItem(KEY,value);}catch(e){}
      el.classList.remove('is-open');
      setTimeout(function(){el.hidden=true;},400);
      document.dispatchEvent(new CustomEvent('cookie:consent',{detail:{value:value}}));
    }

    el.addEventListener('click',function(e){
      var t=e.target.closest('[data-cookie-action]');
      if(!t)return;
      var action=t.getAttribute('data-cookie-action');
      close(action==='accept'?'accepted':'rejected');
    });
  })();
</script>
